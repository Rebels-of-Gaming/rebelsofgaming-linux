<!--
  RoG-Design für Avalonia – Tokens wie auf der Website (docs/DESIGN.md im Website-Repo) und in der Windows-App
  (Themes/RoGTheme.xaml): bg #1C1F26 · bg2 #242832 · bg3 #2D3240 · line #3A4050 · ink #F1EFEA · muted #A8ACB6 ·
  red #E0324A · action-red #D62C43 · gold #D4AE3C · green #3DDC84 (+ blue #4F8CFF für „im Voice“).
  90 % dunkel / 8 % Off-White / 2 % Akzent. Rot = Aktion/Status, Gold = Rang/Auszeichnung. Standard RoG-Dunkel, optional hell bzw. wie das System (Einstellungen).
  Seiten verwenden nur diese Schlüssel und Klassen – keine Einweg-Farben in Views.
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Styles.Resources>
    <ResourceDictionary>
      <!--
        Farben je Design: „Dark“ = RoG-Dunkel (Standard, wie Website und Windows-App), „Light“ = helle Variante für
        „Wie das System“/„Hell“ (Einstellungen). Seiten binden Farben per DynamicResource, damit ein Wechsel sofort wirkt.
        OnAccent = Text auf roten Flächen (in beiden Designs hell).
      -->
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
          <Color x:Key="RoGBgColor">#1C1F26</Color>
          <Color x:Key="RoGBg2Color">#242832</Color>
          <Color x:Key="RoGBg3Color">#2D3240</Color>
          <Color x:Key="RoGLineColor">#3A4050</Color>
          <Color x:Key="RoGInkColor">#F1EFEA</Color>
          <Color x:Key="RoGMutedColor">#A8ACB6</Color>
          <Color x:Key="RoGRedColor">#E0324A</Color>
          <Color x:Key="RoGActionRedColor">#D62C43</Color>
          <Color x:Key="RoGRedPressedColor">#F04A60</Color>
          <Color x:Key="RoGGoldColor">#D4AE3C</Color>
          <Color x:Key="RoGGreenColor">#3DDC84</Color>
          <Color x:Key="RoGBlueColor">#4F8CFF</Color>
          <Color x:Key="RoGOfflineColor">#6B7080</Color>
          <Color x:Key="RoGOnAccentColor">#F1EFEA</Color>
          <SolidColorBrush x:Key="RoGBgBrush" Color="#1C1F26" />
          <SolidColorBrush x:Key="RoGBg2Brush" Color="#242832" />
          <SolidColorBrush x:Key="RoGBg3Brush" Color="#2D3240" />
          <SolidColorBrush x:Key="RoGLineBrush" Color="#3A4050" />
          <SolidColorBrush x:Key="RoGInkBrush" Color="#F1EFEA" />
          <SolidColorBrush x:Key="RoGMutedBrush" Color="#A8ACB6" />
          <SolidColorBrush x:Key="RoGRedBrush" Color="#E0324A" />
          <SolidColorBrush x:Key="RoGActionRedBrush" Color="#D62C43" />
          <SolidColorBrush x:Key="RoGRedPressedBrush" Color="#F04A60" />
          <SolidColorBrush x:Key="RoGGoldBrush" Color="#D4AE3C" />
          <SolidColorBrush x:Key="RoGGreenBrush" Color="#3DDC84" />
          <SolidColorBrush x:Key="RoGBlueBrush" Color="#4F8CFF" />
          <SolidColorBrush x:Key="RoGOfflineBrush" Color="#6B7080" />
          <SolidColorBrush x:Key="RoGOnAccentBrush" Color="#F1EFEA" />
          <SolidColorBrush x:Key="RoGStatusOnlineBrush" Color="#3DDC84" />
          <SolidColorBrush x:Key="RoGStatusVoiceBrush" Color="#4F8CFF" />
          <SolidColorBrush x:Key="RoGStatusServerBrush" Color="#E0324A" />
          <SolidColorBrush x:Key="RoGStatusInGameBrush" Color="#D4AE3C" />
          <SolidColorBrush x:Key="RoGStatusOfflineBrush" Color="#6B7080" />
          <SolidColorBrush x:Key="TextControlBackground" Color="#2D3240" />
          <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#2D3240" />
          <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#242832" />
          <SolidColorBrush x:Key="TextControlBorderBrush" Color="#3A4050" />
          <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#E0324A" />
          <SolidColorBrush x:Key="TextControlForeground" Color="#F1EFEA" />
          <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#F1EFEA" />
          <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#A8ACB6" />
          <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#A8ACB6" />
          <SolidColorBrush x:Key="ScrollBarThumbFill" Color="#3A4050" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
          <Color x:Key="RoGBgColor">#F3F1EC</Color>
          <Color x:Key="RoGBg2Color">#FFFFFF</Color>
          <Color x:Key="RoGBg3Color">#E8E5DE</Color>
          <Color x:Key="RoGLineColor">#D2CEC5</Color>
          <Color x:Key="RoGInkColor">#1C1F26</Color>
          <Color x:Key="RoGMutedColor">#5A5F6B</Color>
          <Color x:Key="RoGRedColor">#C42840</Color>
          <Color x:Key="RoGActionRedColor">#C42840</Color>
          <Color x:Key="RoGRedPressedColor">#A51E34</Color>
          <Color x:Key="RoGGoldColor">#8C6D12</Color>
          <Color x:Key="RoGGreenColor">#1B8A4F</Color>
          <Color x:Key="RoGBlueColor">#2B66D9</Color>
          <Color x:Key="RoGOfflineColor">#8A8F9A</Color>
          <Color x:Key="RoGOnAccentColor">#FFFFFF</Color>
          <SolidColorBrush x:Key="RoGBgBrush" Color="#F3F1EC" />
          <SolidColorBrush x:Key="RoGBg2Brush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="RoGBg3Brush" Color="#E8E5DE" />
          <SolidColorBrush x:Key="RoGLineBrush" Color="#D2CEC5" />
          <SolidColorBrush x:Key="RoGInkBrush" Color="#1C1F26" />
          <SolidColorBrush x:Key="RoGMutedBrush" Color="#5A5F6B" />
          <SolidColorBrush x:Key="RoGRedBrush" Color="#C42840" />
          <SolidColorBrush x:Key="RoGActionRedBrush" Color="#C42840" />
          <SolidColorBrush x:Key="RoGRedPressedBrush" Color="#A51E34" />
          <SolidColorBrush x:Key="RoGGoldBrush" Color="#8C6D12" />
          <SolidColorBrush x:Key="RoGGreenBrush" Color="#1B8A4F" />
          <SolidColorBrush x:Key="RoGBlueBrush" Color="#2B66D9" />
          <SolidColorBrush x:Key="RoGOfflineBrush" Color="#8A8F9A" />
          <SolidColorBrush x:Key="RoGOnAccentBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="RoGStatusOnlineBrush" Color="#1B8A4F" />
          <SolidColorBrush x:Key="RoGStatusVoiceBrush" Color="#2B66D9" />
          <SolidColorBrush x:Key="RoGStatusServerBrush" Color="#C42840" />
          <SolidColorBrush x:Key="RoGStatusInGameBrush" Color="#8C6D12" />
          <SolidColorBrush x:Key="RoGStatusOfflineBrush" Color="#8A8F9A" />
          <SolidColorBrush x:Key="TextControlBackground" Color="#E8E5DE" />
          <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#E8E5DE" />
          <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#FFFFFF" />
          <SolidColorBrush x:Key="TextControlBorderBrush" Color="#D2CEC5" />
          <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#C42840" />
          <SolidColorBrush x:Key="TextControlForeground" Color="#1C1F26" />
          <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#1C1F26" />
          <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#5A5F6B" />
          <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#5A5F6B" />
          <SolidColorBrush x:Key="ScrollBarThumbFill" Color="#D2CEC5" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
      <SolidColorBrush x:Key="RoGTransparentBrush" Color="Transparent" />

      <!-- Schriften: Barlow Condensed (eingebettet, SIL OFL 1.1) für Anzeige-Texte in Versalien; Text = Systemschrift -->
      <FontFamily x:Key="RoGDisplayFont">avares://rebelsofgaming/Assets/Fonts#Barlow Condensed</FontFamily>
      <FontFamily x:Key="RoGMonoFont">DejaVu Sans Mono, Liberation Mono, Noto Sans Mono, monospace</FontFamily>

      <!-- Abstände und Radien -->
      <CornerRadius x:Key="RoGCardRadius">12</CornerRadius>
      <CornerRadius x:Key="RoGControlRadius">8</CornerRadius>
      <Thickness x:Key="RoGPagePadding">32,24,32,32</Thickness>
      <Thickness x:Key="RoGCardPadding">20</Thickness>
      <x:Double x:Key="RoGReadingWidth">720</x:Double>

    </ResourceDictionary>
  </Styles.Resources>

  <!-- Fenster und Grundtext -->
  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource RoGBgBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource RoGInkBrush}" />
  </Style>

  <!-- Textstile (Klassen) -->
  <Style Selector="TextBlock.display, SelectableTextBlock.display">
    <Setter Property="FontFamily" Value="{StaticResource RoGDisplayFont}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="FontSize" Value="40" />
    <Setter Property="LetterSpacing" Value="0.8" />
    <Setter Property="Foreground" Value="{DynamicResource RoGInkBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.title, SelectableTextBlock.title">
    <Setter Property="FontFamily" Value="{StaticResource RoGDisplayFont}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="FontSize" Value="30" />
    <Setter Property="LetterSpacing" Value="0.6" />
    <Setter Property="Foreground" Value="{DynamicResource RoGInkBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.section">
    <Setter Property="FontFamily" Value="{StaticResource RoGDisplayFont}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="18" />
    <Setter Property="LetterSpacing" Value="1.1" />
    <Setter Property="Foreground" Value="{DynamicResource RoGMutedBrush}" />
  </Style>
  <Style Selector="TextBlock.kicker">
    <Setter Property="FontFamily" Value="{StaticResource RoGDisplayFont}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="LetterSpacing" Value="1.2" />
    <Setter Property="Foreground" Value="{DynamicResource RoGRedBrush}" />
  </Style>
  <!-- Kicker in Grün (z. B. „aus Minecraft“) -->
  <Style Selector="TextBlock.kicker.green">
    <Setter Property="Foreground" Value="{DynamicResource RoGGreenBrush}" />
  </Style>
  <Style Selector="TextBlock.body, SelectableTextBlock.body">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="LineHeight" Value="23" />
    <Setter Property="Foreground" Value="{DynamicResource RoGInkBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.muted, SelectableTextBlock.muted">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="LineHeight" Value="21" />
    <Setter Property="Foreground" Value="{DynamicResource RoGMutedBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.small">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="LineHeight" Value="18" />
  </Style>
  <Style Selector="TextBlock.strong">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- Karte (bg2, Linie, Radius) -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource RoGBg2Brush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource RoGLineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RoGCardRadius}" />
    <Setter Property="Padding" Value="{StaticResource RoGCardPadding}" />
  </Style>
  <Style Selector="Border.hint">
    <Setter Property="Background" Value="{DynamicResource RoGBg3Brush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource RoGGoldBrush}" />
    <Setter Property="BorderThickness" Value="1,1,1,1" />
    <Setter Property="CornerRadius" Value="{StaticResource RoGControlRadius}" />
    <Setter Property="Padding" Value="14,10" />
  </Style>
  <Style Selector="Border.error">
    <Setter Property="Background" Value="{DynamicResource RoGBg3Brush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource RoGRedBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RoGControlRadius}" />
    <Setter Property="Padding" Value="14,10" />
  </Style>

  <!-- Knöpfe -->
  <Style Selector="Button.primary, Button.secondary">
    <Setter Property="FontFamily" Value="{StaticResource RoGDisplayFont}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="17" />
    <Setter Property="Padding" Value="20,10" />
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="CornerRadius" Value="{StaticResource RoGControlRadius}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource RoGActionRedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource RoGOnAccentBrush}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource RoGRedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource RoGOnAccentBrush}" />
  </Style>
  <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource RoGRedPressedBrush}" />
  </Style>
  <Style Selector="Button.secondary">
    <Setter Property="Background" Value="{DynamicResource RoGBg3Brush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource RoGLineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource RoGInkBrush}" />
  </Style>
  <Style Selector="Button.secondary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource RoGLineBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource RoGMutedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource RoGInkBrush}" />
  </Style>

  <!-- Link im Fließtext (Inline) -->
  <Style Selector="Button.link">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource RoGRedBrush}" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource RoGRedPressedBrush}" />
  </Style>
  <Style Selector="Button.link.pad">
    <Setter Property="Padding" Value="0,6" />
    <Setter Property="Margin" Value="0,0,16,0" />
  </Style>
  <Style Selector="Button.link TextBlock">
    <Setter Property="TextDecorations" Value="Underline" />
  </Style>

  <!-- Symbol-Knopf (quadratisch, ohne Fläche) -->
  <Style Selector="Button.icon, ToggleButton.icon">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Width" Value="40" />
    <Setter Property="Height" Value="40" />
    <Setter Property="Padding" Value="10" />
    <Setter Property="CornerRadius" Value="{StaticResource RoGControlRadius}" />
    <Setter Property="Foreground" Value="{DynamicResource RoGMutedBrush}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.icon:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.icon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource RoGBg3Brush}" />
    <Setter Property="Foreground" Value="{DynamicResource RoGInkBrush}" />
  </Style>
  <Style Selector="ToggleButton.icon:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource RoGBg3Brush}" />
    <Setter Property="Foreground" Value="{DynamicResource RoGRedBrush}" />
  </Style>

  <!-- Sichtbarer Fokus (Tastatur): Off-White-Rahmen auf allen bedienbaren Elementen -->
  <Style Selector=":is(Control):focus-visible">
    <Setter Property="FocusAdorner">
      <FocusAdornerTemplate>
        <Border BorderBrush="{DynamicResource RoGInkBrush}" BorderThickness="2" CornerRadius="{StaticResource RoGControlRadius}" Margin="-3" />
      </FocusAdornerTemplate>
    </Setter>
  </Style>

  <!-- Seitenleiste -->
  <Style Selector="Button.nav">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Height" Value="36" />
    <Setter Property="CornerRadius" Value="{StaticResource RoGControlRadius}" />
    <Setter Property="Foreground" Value="{DynamicResource RoGMutedBrush}" />
  </Style>
  <Style Selector="Button.nav:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource RoGBg3Brush}" />
    <Setter Property="Foreground" Value="{DynamicResource RoGInkBrush}" />
  </Style>
  <Style Selector="Button.nav.selected">
    <Setter Property="Background" Value="{DynamicResource RoGBg3Brush}" />
    <Setter Property="Foreground" Value="{DynamicResource RoGInkBrush}" />
  </Style>
  <Style Selector="Button.nav TextBlock.navlabel">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.nav.selected TextBlock.navlabel">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.nav Border.navmarker">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.nav.selected Border.navmarker">
    <Setter Property="Background" Value="{DynamicResource RoGRedBrush}" />
  </Style>
  <Style Selector="Button.nav.selected PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource RoGRedBrush}" />
  </Style>

  <!-- Listen (News, Unterhaltungen): Karte je Eintrag, Auswahl mit roter Kante -->
  <Style Selector="ListBox.cards">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="12,0,12,12" />
  </Style>
  <Style Selector="ListBox.cards ListBoxItem">
    <Setter Property="Padding" Value="12" />
    <Setter Property="Margin" Value="0,0,0,6" />
    <Setter Property="CornerRadius" Value="{StaticResource RoGControlRadius}" />
    <Setter Property="Background" Value="{DynamicResource RoGBg2Brush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource RoGBg2Brush}" />
    <Setter Property="BorderThickness" Value="3,0,0,0" />
  </Style>
  <Style Selector="ListBox.cards ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource RoGBg3Brush}" />
  </Style>
  <Style Selector="ListBox.cards ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource RoGBg3Brush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource RoGRedBrush}" />
  </Style>
  <Style Selector="ListBox.cards ListBoxItem:selected:focus /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource RoGBg3Brush}" />
  </Style>
  <Style Selector="ListBox.cards ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource RoGLineBrush}" />
  </Style>

  <!-- Status-Punkt -->
  <Style Selector="Ellipse.dot">
    <Setter Property="Width" Value="10" />
    <Setter Property="Height" Value="10" />
    <Setter Property="Stroke" Value="{DynamicResource RoGBg2Brush}" />
    <Setter Property="StrokeThickness" Value="2" />
  </Style>
  <!-- Hinweis-Leiste (wie InfoBar): Info = blaue Kante -->
  <Style Selector="Border.hint.info">
    <Setter Property="BorderBrush" Value="{DynamicResource RoGBlueBrush}" />
    <Setter Property="BorderThickness" Value="3,1,1,1" />
  </Style>

  <!-- Kachel des Live-Tickers -->
  <Style Selector="Border.card.stat">
    <Setter Property="Padding" Value="18,16" />
    <Setter Property="MinHeight" Value="120" />
  </Style>
  <Style Selector="PathIcon.tone">
    <Setter Property="Foreground" Value="{DynamicResource RoGMutedBrush}" />
  </Style>
  <Style Selector="PathIcon.tone.green">
    <Setter Property="Foreground" Value="{DynamicResource RoGGreenBrush}" />
  </Style>
  <Style Selector="PathIcon.tone.gold">
    <Setter Property="Foreground" Value="{DynamicResource RoGGoldBrush}" />
  </Style>
  <Style Selector="PathIcon.tone.red">
    <Setter Property="Foreground" Value="{DynamicResource RoGRedBrush}" />
  </Style>
  <Style Selector="PathIcon.tone.blue">
    <Setter Property="Foreground" Value="{DynamicResource RoGBlueBrush}" />
  </Style>

  <!-- Zeile in einer Karte (News/Termine der Startseite): ganze Breite, Fläche nur beim Überfahren -->
  <Style Selector="Button.row">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="8,8" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="CornerRadius" Value="{StaticResource RoGControlRadius}" />
    <Setter Property="Foreground" Value="{DynamicResource RoGInkBrush}" />
  </Style>
  <Style Selector="Button.row:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource RoGBg3Brush}" />
  </Style>

  <!-- Zeile als Kachel (Listen aus Knöpfen: Suche, Info, Glocke, Line-up, Intern) -->
  <Style Selector="Button.row.tile /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource RoGBg2Brush}" />
  </Style>
  <Style Selector="Button.row.tile:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource RoGBg3Brush}" />
  </Style>

  <!-- Häkchen der Onboarding-Liste -->
  <Style Selector="Border.check">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="BorderBrush" Value="{DynamicResource RoGLineBrush}" />
  </Style>
  <Style Selector="Border.check.done">
    <Setter Property="Background" Value="{DynamicResource RoGGreenBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource RoGGreenBrush}" />
  </Style>

  <!-- Fortschritt im RoG-Rot -->
  <Style Selector="ProgressBar">
    <Setter Property="Foreground" Value="{DynamicResource RoGRedBrush}" />
    <Setter Property="Background" Value="{DynamicResource RoGBg3Brush}" />
  </Style>

  <!-- Einstellungen: Beschriftung über Auswahlfeldern -->
  <Style Selector="TextBlock.label">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{DynamicResource RoGMutedBrush}" />
    <Setter Property="Margin" Value="0,0,0,6" />
  </Style>

  <!-- Kopfleiste der schmalen Ansicht und Überlagerung der Seitenleiste -->
  <Style Selector="Border.topbar">
    <Setter Property="Background" Value="{DynamicResource RoGBg2Brush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource RoGLineBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Height" Value="52" />
    <Setter Property="Padding" Value="6,0,12,0" />
  </Style>
  <Style Selector="Border.scrim">
    <Setter Property="Background" Value="#99000000" />
  </Style>
  <!-- Rückmeldung nach Aktionen (wie InfoBar der Windows-App): Erfolg grün, Hinweis blau, Fehler rot -->
  <Style Selector="Border.hint.success">
    <Setter Property="BorderBrush" Value="{DynamicResource RoGGreenBrush}" />
    <Setter Property="BorderThickness" Value="3,1,1,1" />
  </Style>
  <Style Selector="Border.hint.error">
    <Setter Property="BorderBrush" Value="{DynamicResource RoGRedBrush}" />
    <Setter Property="BorderThickness" Value="3,1,1,1" />
  </Style>

  <!-- Chip (Rekrutierung, Abzeichen, Spiel): kleine Fläche mit farbiger Kante -->
  <Style Selector="Border.chip">
    <Setter Property="Background" Value="{DynamicResource RoGBg3Brush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource RoGLineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="11" />
    <Setter Property="Padding" Value="9,2" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.chip TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource RoGInkBrush}" />
  </Style>
  <Style Selector="Border.chip.green">
    <Setter Property="BorderBrush" Value="{DynamicResource RoGGreenBrush}" />
  </Style>
  <Style Selector="Border.chip.gold">
    <Setter Property="BorderBrush" Value="{DynamicResource RoGGoldBrush}" />
  </Style>
  <Style Selector="Border.chip.red">
    <Setter Property="BorderBrush" Value="{DynamicResource RoGRedBrush}" />
  </Style>

  <!-- Umschalter (Squads/Spiele, Alle/Team, Liste/Monat, Reiter im Detail): wie ein Segment-Control -->
  <Style Selector="ToggleButton.segment">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource RoGMutedBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0,0,0,2" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="FontFamily" Value="{StaticResource RoGDisplayFont}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="LetterSpacing" Value="1" />
  </Style>
  <Style Selector="ToggleButton.segment:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource RoGBg3Brush}" />
    <Setter Property="Foreground" Value="{DynamicResource RoGInkBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="ToggleButton.segment:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource RoGInkBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource RoGRedBrush}" />
  </Style>
  <Style Selector="ToggleButton.segment:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource RoGBg3Brush}" />
  </Style>

  <!-- Sprechblase im Chat: fremde links (bg2), eigene rechts (bg3, rote Kante) -->
  <Style Selector="Border.bubble">
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="MaxWidth" Value="560" />
    <Setter Property="Background" Value="{DynamicResource RoGBg2Brush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource RoGLineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12,12,12,4" />
    <Setter Property="Padding" Value="14,10" />
  </Style>
  <Style Selector="Border.bubble.mine">
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="Background" Value="{DynamicResource RoGBg3Brush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource RoGActionRedBrush}" />
    <Setter Property="BorderThickness" Value="0,0,3,0" />
    <Setter Property="CornerRadius" Value="12,12,4,12" />
  </Style>
  <Style Selector="Border.bubble:focus-visible">
    <Setter Property="BorderBrush" Value="{DynamicResource RoGInkBrush}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>
  <Style Selector="TextBlock.error">
    <Setter Property="Foreground" Value="{DynamicResource RoGRedBrush}" />
  </Style>

  <!-- Status-Text eines Servers -->
  <Style Selector="TextBlock.status-online">
    <Setter Property="Foreground" Value="{DynamicResource RoGGreenBrush}" />
  </Style>

  <!-- Zelle der Monatsansicht -->
  <Style Selector="Button.day">
    <Setter Property="Background" Value="{DynamicResource RoGBg2Brush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource RoGLineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RoGControlRadius}" />
    <Setter Property="Padding" Value="6,4" />
    <Setter Property="Margin" Value="2" />
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
    <Setter Property="Foreground" Value="{DynamicResource RoGInkBrush}" />
  </Style>
  <Style Selector="Button.day:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource RoGBg3Brush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource RoGMutedBrush}" />
  </Style>
  <Style Selector="Button.day.outside">
    <Setter Property="Opacity" Value="0.4" />
  </Style>
  <Style Selector="Button.day.today">
    <Setter Property="BorderBrush" Value="{DynamicResource RoGRedBrush}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>
  <Style Selector="Button.day.selected">
    <Setter Property="Background" Value="{DynamicResource RoGBg3Brush}" />
  </Style>

  <!-- Gruppenüberschrift in Listen (Info, Suche, Termine nach Tag) -->
  <Style Selector="TextBlock.group">
    <Setter Property="FontFamily" Value="{StaticResource RoGDisplayFont}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="LetterSpacing" Value="1.2" />
    <Setter Property="Foreground" Value="{DynamicResource RoGMutedBrush}" />
    <Setter Property="Margin" Value="4,10,0,4" />
  </Style>
</Styles>
