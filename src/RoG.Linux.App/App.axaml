<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RoG.Linux.App.ViewModels"
             xmlns:views="using:RoG.Linux.App.Views"
             x:Class="RoG.Linux.App.App"
             Name="Rebels of Gaming"
             RequestedThemeVariant="Dark">
  <!-- Standard RoG-Dunkel; „Hell“/„Wie das System“ setzt ThemeService beim Start bzw. aus den Einstellungen -->

  <!-- Seite je ViewModel (kein Reflection-ViewLocator: trim-/AOT-freundlich) -->
  <Application.DataTemplates>
    <DataTemplate DataType="vm:LoginViewModel"><views:LoginView /></DataTemplate>
    <DataTemplate DataType="vm:HomeViewModel"><views:HomeView /></DataTemplate>
    <DataTemplate DataType="vm:SettingsViewModel"><views:SettingsView /></DataTemplate>
    <DataTemplate DataType="vm:NewsViewModel"><views:NewsView /></DataTemplate>
    <DataTemplate DataType="vm:MessagesViewModel"><views:MessagesView /></DataTemplate>
    <DataTemplate DataType="vm:AccountViewModel"><views:AccountView /></DataTemplate>
    <DataTemplate DataType="vm:PlaceholderViewModel"><views:PlaceholderView /></DataTemplate>
    <DataTemplate DataType="vm:SquadsViewModel"><views:SquadsView /></DataTemplate>
    <DataTemplate DataType="vm:MembersViewModel"><views:MembersView /></DataTemplate>
    <DataTemplate DataType="vm:ServersViewModel"><views:ServersView /></DataTemplate>
    <DataTemplate DataType="vm:EventsViewModel"><views:EventsView /></DataTemplate>
    <DataTemplate DataType="vm:InfoViewModel"><views:InfoView /></DataTemplate>
    <DataTemplate DataType="vm:SearchViewModel"><views:SearchView /></DataTemplate>
    <DataTemplate DataType="vm:NotificationsViewModel"><views:NotificationsView /></DataTemplate>
    <DataTemplate DataType="vm:ForumViewModel"><views:ForumView /></DataTemplate>
    <DataTemplate DataType="vm:UploadsViewModel"><views:UploadsView /></DataTemplate>
    <DataTemplate DataType="vm:MediaViewModel"><views:MediaView /></DataTemplate>
    <DataTemplate DataType="vm:VotesViewModel"><views:VotesView /></DataTemplate>
    <DataTemplate DataType="vm:MatchesViewModel"><views:MatchesView /></DataTemplate>
    <DataTemplate DataType="vm:LeaderboardsViewModel"><views:LeaderboardsView /></DataTemplate>
    <DataTemplate DataType="vm:FriendsViewModel"><views:FriendsView /></DataTemplate>
    <!-- Bausteine, die mehrere Seiten zeigen -->
    <DataTemplate DataType="vm:ServerItemViewModel"><views:ServerCard /></DataTemplate>
    <DataTemplate DataType="vm:InternalRowViewModel">
      <Button Classes="row tile" Padding="12,10" Command="{Binding OpenCommand}"
              AutomationProperties.Name="{Binding Title}">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <PathIcon Data="{Binding Icon}" Width="18" Height="18" Foreground="{DynamicResource RoGMutedBrush}" VerticalAlignment="Top" Margin="0,2,12,0" />
          <StackPanel Grid.Column="1" Spacing="2">
            <TextBlock Classes="body" Classes.strong="{Binding IsUnread}" Text="{Binding Title}" TextTrimming="CharacterEllipsis" MaxLines="2" />
            <TextBlock Classes="muted small" Text="{Binding Meta}" IsVisible="{Binding HasMeta}" TextTrimming="CharacterEllipsis" MaxLines="2" />
          </StackPanel>
          <Ellipse Grid.Column="2" Width="10" Height="10" Fill="{DynamicResource RoGRedBrush}" IsVisible="{Binding IsUnread}" VerticalAlignment="Center" Margin="8,0,0,0" />
        </Grid>
      </Button>
    </DataTemplate>
  </Application.DataTemplates>

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://rebelsofgaming/Themes/Icons.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <!-- Fluent im RoG-Ton (dunkel Standard, hell optional), Akzent = RoG-Rot, Flächen = bg/bg2/bg3 -->
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Dark"
                               Accent="#E0324A"
                               RegionColor="#1C1F26"
                               AltHigh="#1C1F26"
                               AltLow="#1C1F26"
                               AltMedium="#1C1F26"
                               AltMediumHigh="#1C1F26"
                               AltMediumLow="#1C1F26"
                               BaseHigh="#F1EFEA"
                               BaseMediumHigh="#D9D7D2"
                               BaseMedium="#A8ACB6"
                               BaseMediumLow="#6B7080"
                               BaseLow="#3A4050"
                               ChromeAltLow="#F1EFEA"
                               ChromeHigh="#3A4050"
                               ChromeMedium="#2D3240"
                               ChromeMediumLow="#242832"
                               ChromeLow="#242832"
                               ChromeGray="#A8ACB6"
                               ChromeWhite="#F1EFEA"
                               ListLow="#2D3240"
                               ListMedium="#3A4050"
                               ErrorText="#F04A60" />
        <ColorPaletteResources x:Key="Light"
                               Accent="#C42840"
                               RegionColor="#F3F1EC"
                               AltHigh="#FFFFFF"
                               AltLow="#FFFFFF"
                               AltMedium="#FFFFFF"
                               AltMediumHigh="#FFFFFF"
                               AltMediumLow="#FFFFFF"
                               BaseHigh="#1C1F26"
                               BaseMediumHigh="#2D3240"
                               BaseMedium="#5A5F6B"
                               BaseMediumLow="#8A8F9A"
                               BaseLow="#D2CEC5"
                               ChromeAltLow="#1C1F26"
                               ChromeHigh="#D2CEC5"
                               ChromeMedium="#E8E5DE"
                               ChromeMediumLow="#F3F1EC"
                               ChromeLow="#FFFFFF"
                               ChromeGray="#5A5F6B"
                               ChromeWhite="#FFFFFF"
                               ListLow="#E8E5DE"
                               ListMedium="#D2CEC5"
                               ErrorText="#A51E34" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <StyleInclude Source="avares://rebelsofgaming/Themes/RoGTheme.axaml" />
  </Application.Styles>
</Application>
