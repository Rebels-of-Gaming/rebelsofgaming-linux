<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RoG.Linux.App.ViewModels"
        xmlns:l="using:RoG.Linux.App.Localization"
        x:Class="RoG.Linux.App.Views.MainWindow"
        x:DataType="vm:ShellViewModel"
        Title="Rebels of Gaming"
        Icon="avares://rebelsofgaming/Assets/rog-badge-512.png"
        Width="1280" Height="800"
        MinWidth="360" MinHeight="500"
        WindowStartupLocation="CenterScreen">

  <Panel>
    <!-- Shell: Seitenleiste wie die NavigationView der Windows-App + aktuelle Seite -->
    <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding IsShellVisible}">
      <Border Grid.Column="0"
              Width="{Binding PaneWidth}"
              Background="{StaticResource RoGBg2Brush}"
              BorderBrush="{StaticResource RoGLineBrush}"
              BorderThickness="0,0,1,0">
        <DockPanel>
          <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*" Height="56" Margin="12,8,12,8">
            <Button Classes="icon"
                    Command="{Binding TogglePaneCommand}"
                    ToolTip.Tip="{Binding MenuToggleText}"
                    AutomationProperties.Name="{Binding MenuToggleText}">
              <PathIcon Data="{StaticResource IconMenu}" Width="20" Height="20" />
            </Button>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" Margin="10,0,0,0"
                        VerticalAlignment="Center" IsVisible="{Binding IsPaneExpanded}">
              <Image Source="avares://rebelsofgaming/Assets/rog-badge-512.png" Width="26" Height="26" />
              <TextBlock Text="{l:T Shell_TitleBar.Text}"
                         FontFamily="{StaticResource RoGDisplayFont}" FontWeight="SemiBold" FontSize="16"
                         LetterSpacing="1.2" Foreground="{StaticResource RoGInkBrush}" VerticalAlignment="Center" />
            </StackPanel>
          </Grid>

          <ItemsControl DockPanel.Dock="Bottom" ItemsSource="{Binding FooterItems}" Margin="8,8,8,12">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:NavItem">
                <Button Classes="nav" Classes.selected="{Binding IsSelected}"
                        Command="{Binding $parent[Window].((vm:ShellViewModel)DataContext).NavigateCommand}"
                        CommandParameter="{Binding}"
                        ToolTip.Tip="{Binding Label}"
                        AutomationProperties.Name="{Binding Label}"
                        Margin="0,2">
                  <Grid ColumnDefinitions="3,45,*,Auto">
                    <Border Classes="navmarker" Width="3" Height="20" CornerRadius="2" VerticalAlignment="Center" />
                    <PathIcon Grid.Column="1" Data="{Binding Icon}" Width="20" Height="20" HorizontalAlignment="Center" />
                    <TextBlock Grid.Column="2" Classes="navlabel" Text="{Binding Label}"
                               IsVisible="{Binding $parent[Window].((vm:ShellViewModel)DataContext).IsPaneExpanded}" />
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Border DockPanel.Dock="Bottom" Height="1" Background="{StaticResource RoGLineBrush}" Margin="16,0" />

          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding MainItems}" Margin="8,4,8,8">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:NavItem">
                  <Button Classes="nav" Classes.selected="{Binding IsSelected}"
                          Command="{Binding $parent[Window].((vm:ShellViewModel)DataContext).NavigateCommand}"
                          CommandParameter="{Binding}"
                          ToolTip.Tip="{Binding Label}"
                          AutomationProperties.Name="{Binding Label}"
                          Margin="0,2">
                    <Grid ColumnDefinitions="3,45,*,Auto">
                      <Border Classes="navmarker" Width="3" Height="20" CornerRadius="2" VerticalAlignment="Center" />
                      <PathIcon Grid.Column="1" Data="{Binding Icon}" Width="20" Height="20" HorizontalAlignment="Center" />
                      <TextBlock Grid.Column="2" Classes="navlabel" Text="{Binding Label}"
                                 IsVisible="{Binding $parent[Window].((vm:ShellViewModel)DataContext).IsPaneExpanded}" />
                      <Border Grid.Column="3" IsVisible="{Binding HasBadge}" Background="{StaticResource RoGRedBrush}"
                              CornerRadius="9" MinWidth="18" Height="18" Padding="5,0" Margin="0,0,10,0">
                        <TextBlock Text="{Binding BadgeText}" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource RoGInkBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <ContentControl Grid.Column="1" Content="{Binding CurrentPage}" />
    </Grid>

    <!-- Login liegt über allem, solange weder Token noch Gastmodus da sind -->
    <ContentControl Content="{Binding Login}" IsVisible="{Binding IsLoginVisible}" />
  </Panel>
</Window>
