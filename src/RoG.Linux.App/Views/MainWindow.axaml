<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RoG.Linux.App.ViewModels"
        xmlns:views="using:RoG.Linux.App.Views"
        x:Class="RoG.Linux.App.Views.MainWindow"
        x:DataType="vm:ShellViewModel"
        Title="Rebels of Gaming"
        Icon="avares://rebelsofgaming/Assets/rog-badge-512.png"
        Width="1280" Height="800"
        MinWidth="360" MinHeight="500"
        WindowStartupLocation="CenterScreen">

  <Panel>
    <!-- Shell: Seitenleiste wie die NavigationView der Windows-App + aktuelle Seite -->
    <DockPanel IsVisible="{Binding IsShellVisible}">
      <!-- Schmale Ansicht (< 600 px): Kopfleiste mit Menü-Knopf statt fester Seitenleiste -->
      <Border DockPanel.Dock="Top" Classes="topbar" IsVisible="{Binding IsNarrow}">
        <Grid ColumnDefinitions="Auto,Auto,*">
          <Button Classes="icon" Command="{Binding TogglePaneCommand}"
                  ToolTip.Tip="{Binding OpenMenuText}" AutomationProperties.Name="{Binding OpenMenuText}">
            <PathIcon Data="{StaticResource IconMenu}" Width="20" Height="20" />
          </Button>
          <Image Grid.Column="1" Source="avares://rebelsofgaming/Assets/rog-badge-512.png" Width="24" Height="24" Margin="6,0,10,0" />
          <TextBlock Grid.Column="2" Text="{Binding CurrentTitle}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                     FontFamily="{StaticResource RoGDisplayFont}" FontWeight="SemiBold" FontSize="18" LetterSpacing="1"
                     Foreground="{DynamicResource RoGInkBrush}" />
        </Grid>
      </Border>

      <Grid ColumnDefinitions="Auto,*">
        <views:NavPane Width="{Binding PaneWidth}" ShowLabels="{Binding ShowLabels}" IsVisible="{Binding ShowSidePane}" />
        <ContentControl Grid.Column="1" Content="{Binding CurrentPage}" />
      </Grid>
    </DockPanel>

    <!-- Seitenleiste als Überlagerung (schmale Ansicht); Klick daneben oder Escape schließt sie -->
    <Panel IsVisible="{Binding IsOverlayOpen}">
      <Border Classes="scrim" PointerPressed="OnScrimPressed" AutomationProperties.Name="{Binding CloseMenuText}" />
      <views:NavPane x:Name="OverlayPane" Width="272" HorizontalAlignment="Left" ShowLabels="True" />
    </Panel>

    <!-- Login liegt über allem, solange weder Token noch Gastmodus da sind -->
    <ContentControl Content="{Binding Login}" IsVisible="{Binding IsLoginVisible}" />
  </Panel>
</Window>
