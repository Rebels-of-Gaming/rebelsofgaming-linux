<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RoG.Linux.App.ViewModels"
        xmlns:c="using:RoG.Linux.App.Controls"
        xmlns:l="using:RoG.Linux.App.Localization"
        x:Class="RoG.Linux.App.Views.AdminEditorWindow"
        x:DataType="vm:AdminEditorViewModel"
        Width="1040" Height="720" MinWidth="360" MinHeight="400"
        Icon="avares://rebelsofgaming/Assets/rog-badge-512.png"
        Background="{DynamicResource RoGBgBrush}"
        Title="{Binding Title}">
  <!-- Allgemeiner Editor eines Bereichs der Website-Verwaltung (wie AdminEditorWindow der Windows-App): Liste links, Formular rechts -->
  <Window.Resources>
    <!-- Formular (auch für Einstellungen ohne Liste) -->
    <DataTemplate x:Key="FormTemplate" x:DataType="vm:AdminEditorViewModel">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <!-- Lesebreite: Spalte höchstens 720 px, links ausgerichtet, Felder füllen sie aus -->
        <Grid Margin="24,12,24,32">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MaxWidth="{StaticResource RoGReadingWidth}" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
        <StackPanel Spacing="14">
          <Button Classes="secondary" HorizontalAlignment="Left" Command="{Binding CloseFormCommand}"
                  IsVisible="{Binding $parent[c:ListDetailPanel].IsNarrow, FallbackValue=False}"
                  AutomationProperties.Name="{l:T Common_Back}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <PathIcon Data="{StaticResource IconBack}" Width="16" Height="16" />
              <TextBlock Text="{l:T Common_Back}" />
            </StackPanel>
          </Button>
          <TextBlock Classes="title" Text="{Binding FormTitle}" TextWrapping="Wrap" />
          <TextBlock Classes="muted small" Text="{Binding Help}" IsVisible="{Binding HasHelp}" TextWrapping="Wrap" />
          <c:AdminFieldsView Fields="{Binding Fields}" />
          <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8">
            <Button Classes="primary" Command="{Binding SaveCommand}" IsVisible="{Binding CanSave}"
                    Content="{l:T AdminForm_Save.Content, Upper=True}" AutomationProperties.Name="{l:T AdminForm_Save.Content}" />
            <Button Classes="secondary" Command="{Binding DeleteCommand}" IsVisible="{Binding CanDelete}"
                    Content="{l:T AdminForm_Delete.Content}" />
            <Button Classes="secondary" Command="{Binding OpenWebCommand}" IsVisible="{Binding HasWebPath}"
                    AutomationProperties.Name="{l:T AdminForm_OpenWeb.Content}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <PathIcon Data="{StaticResource IconOpenExternal}" Width="14" Height="14" />
                <TextBlock Text="{l:T AdminForm_OpenWeb.Content}" />
              </StackPanel>
            </Button>
          </WrapPanel>
        </StackPanel>
        </Grid>
      </ScrollViewer>
    </DataTemplate>
  </Window.Resources>

  <DockPanel>
    <!-- Titel -->
    <Border DockPanel.Dock="Top" Background="{DynamicResource RoGBg2Brush}" BorderBrush="{DynamicResource RoGLineBrush}" BorderThickness="0,0,0,1"
            Padding="16,8">
      <Grid ColumnDefinitions="Auto,*">
        <PathIcon Data="{StaticResource IconAdmin}" Width="16" Height="16" Foreground="{DynamicResource RoGMutedBrush}" Margin="0,0,10,0" />
        <TextBlock Grid.Column="1" x:Name="TitleText" Classes="section" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
      </Grid>
    </Border>

    <!-- Rückfrage und Rückmeldung -->
    <StackPanel DockPanel.Dock="Top" Margin="16,8,16,0" Spacing="8">
      <c:ConfirmBar DataContext="{Binding Confirm}" MaxWidth="{StaticResource RoGReadingWidth}" HorizontalAlignment="Left" />
      <c:FeedbackBar DataContext="{Binding Feedback}" MaxWidth="{StaticResource RoGReadingWidth}" HorizontalAlignment="Left" />
    </StackPanel>

    <Panel>
      <!-- Einstellungen (ein Objekt): nur das Formular -->
      <Panel IsVisible="{Binding IsSingleton}">
        <c:StateView IsLoading="{Binding ShowSingletonLoading}" />
        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource FormTemplate}" IsVisible="{Binding HasForm}" />
      </Panel>

      <!-- Liste + Formular -->
      <c:ListDetailPanel x:Name="Panel" IsVisible="{Binding ShowList}" IsDetailOpen="{Binding HasForm}" ListWidth="300">
        <Border BorderBrush="{DynamicResource RoGLineBrush}" BorderThickness="0,0,1,0">
          <DockPanel Margin="16,8,16,16">
            <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,8">
              <Button Classes="primary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding NewCommand}"
                      IsVisible="{Binding CanCreate}" AutomationProperties.Name="{l:T AdminForm_NewButton.Content}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <PathIcon Data="{StaticResource IconPlus}" Width="14" Height="14" />
                  <TextBlock Text="{l:T AdminForm_NewButton.Content, Upper=True}" />
                </StackPanel>
              </Button>
              <TextBox x:Name="SearchBox" Text="{Binding Search}" PlaceholderText="{l:T AdminForm_Search.PlaceholderText}"
                       AutomationProperties.Name="{l:T AdminForm_Search.PlaceholderText}" />
            </StackPanel>
            <Button DockPanel.Dock="Bottom" Classes="secondary" HorizontalAlignment="Stretch" Margin="0,8,0,0" Command="{Binding MoreCommand}"
                    IsVisible="{Binding HasMore}" Content="{l:T AdminForm_More.Content}" />
            <Panel>
              <c:StateView IsLoading="{Binding IsLoading}" ErrorMessage="{Binding ListError}" IsEmpty="{Binding IsEmpty}"
                           EmptyText="{l:T AdminForm_Empty.Text}" RetryCommand="{Binding RetryCommand}" />
              <ListBox Classes="cards" ItemsSource="{Binding Records}" SelectedItem="{Binding Selected}" SelectionMode="Single"
                       IsVisible="{Binding ShowRecords}" AutomationProperties.Name="{l:T AdminForm_List.AutomationProperties.Name}">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:AdminRecordViewModel">
                    <StackPanel Spacing="2" AutomationProperties.Name="{Binding Title}">
                      <TextBlock Classes="body strong" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Classes="muted small" Text="{Binding Subtitle}" IsVisible="{Binding HasSubtitle}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Panel>
          </DockPanel>
        </Border>

        <Panel>
          <TextBlock Classes="muted" Text="{l:T AdminForm_SelectHint.Text}" HorizontalAlignment="Center" VerticalAlignment="Center"
                     IsVisible="{Binding HasNoForm}" Margin="32" TextWrapping="Wrap" />
          <ContentControl Content="{Binding}" ContentTemplate="{StaticResource FormTemplate}" IsVisible="{Binding HasForm}" />
        </Panel>
      </c:ListDetailPanel>
    </Panel>
  </DockPanel>
</Window>
