<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RoG.Linux.App.ViewModels"
             xmlns:l="using:RoG.Linux.App.Localization"
             x:Class="RoG.Linux.App.Views.AccountView"
             x:DataType="vm:AccountViewModel">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="{StaticResource RoGPagePadding}" Spacing="20" MaxWidth="{StaticResource RoGReadingWidth}" HorizontalAlignment="Left">
      <TextBlock Classes="display" Text="{l:T AccountPage_Title.Text}" />

      <Border Classes="card">
        <Grid ColumnDefinitions="Auto,*">
          <Panel Width="80" Height="80" VerticalAlignment="Top">
            <Border CornerRadius="40" Background="{DynamicResource RoGBg3Brush}" BorderBrush="{DynamicResource RoGGoldBrush}" BorderThickness="2">
              <TextBlock Text="{Binding Initial}" FontFamily="{StaticResource RoGDisplayFont}" FontWeight="Bold" FontSize="36"
                         Foreground="{DynamicResource RoGInkBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <Border CornerRadius="40" ClipToBounds="True" IsVisible="{Binding !HasNoAvatar}" BorderBrush="{DynamicResource RoGGoldBrush}" BorderThickness="2">
              <Image Source="{Binding Avatar}" Stretch="UniformToFill" />
            </Border>
          </Panel>
          <StackPanel Grid.Column="1" Spacing="6" Margin="20,0,0,0" VerticalAlignment="Center">
            <TextBlock Classes="title" Text="{Binding Name}" IsVisible="{Binding IsSignedIn}" />
            <TextBlock Classes="kicker" Foreground="{DynamicResource RoGGoldBrush}" Text="{Binding Rank}" />
            <TextBlock Classes="muted" Text="{Binding Details}" />
          </StackPanel>
        </Grid>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="10">
          <Grid ColumnDefinitions="Auto,*">
            <PathIcon Data="{StaticResource IconKey}" Width="18" Height="18" Foreground="{DynamicResource RoGMutedBrush}" VerticalAlignment="Top" Margin="0,3,10,0" />
            <TextBlock Grid.Column="1" Classes="body" Text="{Binding StorageText}" />
          </Grid>
          <TextBlock Classes="muted small" Text="{Binding EnvironmentText}" />
          <TextBlock Classes="muted small" Text="{Binding VersionText}" />
        </StackPanel>
      </Border>

      <StackPanel Spacing="10" IsVisible="{Binding IsSignedIn}">
        <TextBlock Classes="muted small" Text="{l:T Account_SignOutText}" />
        <Button Classes="primary" HorizontalAlignment="Left" Command="{Binding SignOutCommand}" IsEnabled="{Binding !IsBusy}">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <PathIcon Data="{StaticResource IconLogout}" Width="18" Height="18" />
            <TextBlock Text="{l:T AccountPage_SignOut.Content}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </StackPanel>

      <Button Classes="primary" HorizontalAlignment="Left" Command="{Binding SignInCommand}" IsVisible="{Binding IsGuest}"
              Content="{l:T Linux_SignIn}" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
