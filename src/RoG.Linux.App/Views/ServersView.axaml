<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RoG.Linux.App.ViewModels"
             xmlns:c="using:RoG.Linux.App.Controls"
             xmlns:l="using:RoG.Linux.App.Localization"
             x:Class="RoG.Linux.App.Views.ServersView"
             x:DataType="vm:ServersViewModel">
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Spacing="10" Margin="24,24,24,12">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Classes="display" Text="{l:T ServersPage_Title.Text}" />
        <Button Grid.Column="1" Classes="icon" VerticalAlignment="Center" Command="{Binding RefreshCommand}"
                ToolTip.Tip="{l:T ServersPage_Refresh.ToolTipService.ToolTip}" AutomationProperties.Name="{l:T Linux_Refresh}">
          <PathIcon Data="{StaticResource IconRefresh}" Width="20" Height="20" />
        </Button>
      </Grid>
      <TextBlock Classes="muted" Text="{l:T ServersPage_Intro.Text}" MaxWidth="{StaticResource RoGReadingWidth}" HorizontalAlignment="Left" />
      <c:FeedbackBar DataContext="{Binding Feedback}" MaxWidth="{StaticResource RoGReadingWidth}" HorizontalAlignment="Left" />
    </StackPanel>
    <Panel>
      <c:StateView IsLoading="{Binding IsLoading}" ErrorMessage="{Binding ErrorMessage}" IsEmpty="{Binding IsEmpty}"
                   EmptyText="{l:T ServersPage_Empty.Text}" RetryCommand="{Binding RefreshCommand}" />
      <ScrollViewer IsVisible="{Binding ShowContent}" VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding Servers}" Margin="24,4,24,32" AutomationProperties.Name="{l:T ServersPage_Title.Text}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><c:AdaptiveGrid MinItemWidth="320" Spacing="16" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>
      </ScrollViewer>
    </Panel>
  </DockPanel>
</UserControl>
