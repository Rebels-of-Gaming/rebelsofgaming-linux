<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RoG.Linux.App.ViewModels"
             xmlns:l="using:RoG.Linux.App.Localization"
             xmlns:c="using:RoG.Linux.App.Controls"
             x:Class="RoG.Linux.App.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
  <!-- Einstellungen wie SettingsPage der Windows-App; „Windows“-Karte wird „Linux-Desktop“ -->
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="{StaticResource RoGPagePadding}" Spacing="16" MaxWidth="{StaticResource RoGReadingWidth}" HorizontalAlignment="Left">
      <TextBlock Classes="display" Text="{l:T SettingsPage_Title.Text}" />

      <Border Classes="hint info" IsVisible="{Binding RestartRequired}">
        <TextBlock Classes="body" Text="{l:T SettingsPage_RestartHint.Message}" />
      </Border>

      <!-- Allgemein -->
      <Border Classes="card">
        <StackPanel Spacing="16">
          <TextBlock Classes="section" Text="{l:T SettingsPage_GeneralTitle.Text}" />
          <StackPanel>
            <TextBlock Classes="label" Text="{l:T SettingsPage_Language.Header}" />
            <ComboBox MinWidth="260" ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}"
                      AutomationProperties.Name="{l:T SettingsPage_Language.Header}" />
          </StackPanel>
          <StackPanel>
            <TextBlock Classes="label" Text="{l:T Linux_ThemeHeader}" />
            <ComboBox MinWidth="260" ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}"
                      AutomationProperties.Name="{l:T Linux_ThemeHeader}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Benachrichtigungen (Website, E-Mail, Discord) – nur angemeldet, lädt beim Aufklappen -->
      <Expander IsVisible="{Binding NotificationSettings.IsSignedIn}" IsExpanded="{Binding NotificationSettings.IsExpanded}"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" AutomationProperties.Name="{l:T SettingsPage_Notifications.Header}">
        <Expander.Header>
          <TextBlock Classes="section" Text="{l:T SettingsPage_Notifications.Header, Upper=True}" TextWrapping="Wrap" />
        </Expander.Header>
        <StackPanel Spacing="12" DataContext="{Binding NotificationSettings}" x:DataType="vm:NotificationSettingsViewModel">
          <c:FeedbackBar DataContext="{Binding Feedback}" />
          <StackPanel>
            <TextBlock Classes="label" Text="{l:T SettingsPage_Digest.Header}" />
            <ComboBox MinWidth="260" ItemsSource="{Binding DigestOptions}" SelectedItem="{Binding SelectedDigest}"
                      AutomationProperties.Name="{l:T SettingsPage_Digest.Header}" />
          </StackPanel>
          <WrapPanel Orientation="Horizontal">
            <StackPanel Margin="0,0,12,8">
              <TextBlock Classes="label" Text="{l:T SettingsPage_QuietFrom.Header}" />
              <TextBox Width="110" Text="{Binding QuietFrom}" PlaceholderText="22:00" AutomationProperties.Name="{l:T SettingsPage_QuietFrom.Header}" />
            </StackPanel>
            <StackPanel Margin="0,0,12,8">
              <TextBlock Classes="label" Text="{l:T SettingsPage_QuietUntil.Header}" />
              <TextBox Width="110" Text="{Binding QuietUntil}" PlaceholderText="08:00" AutomationProperties.Name="{l:T SettingsPage_QuietUntil.Header}" />
            </StackPanel>
            <Button Classes="secondary" VerticalAlignment="Bottom" Margin="0,0,0,8" Command="{Binding SaveQuietHoursCommand}"
                    Content="{l:T SettingsPage_QuietSave.Content}" />
          </WrapPanel>
          <c:StateView IsLoading="{Binding IsLoading}" ErrorMessage="{Binding ErrorMessage}" RetryCommand="{Binding RefreshCommand}" MinHeight="60" />
          <ItemsControl ItemsSource="{Binding Items}" IsVisible="{Binding ShowContent}" AutomationProperties.Name="{l:T SettingsPage_Notifications.Header}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:NotificationTypeRowViewModel">
                <Border BorderBrush="{DynamicResource RoGLineBrush}" BorderThickness="0,0,0,1" Padding="0,6">
                  <Grid ColumnDefinitions="*,Auto" AutomationProperties.Name="{Binding Label}">
                    <TextBlock Classes="body" Text="{Binding Label}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                      <CheckBox IsChecked="{Binding Bell}" IsVisible="{Binding ShowBell}" Margin="0,0,12,0" Content="{l:T SettingsPage_ChannelBell.Content}" />
                      <CheckBox IsChecked="{Binding Mail}" IsVisible="{Binding ShowMail}" Margin="0,0,12,0" Content="{l:T SettingsPage_ChannelMail.Content}" />
                      <CheckBox IsChecked="{Binding Discord}" IsVisible="{Binding ShowDiscord}" Content="{l:T SettingsPage_ChannelDiscord.Content}" />
                    </WrapPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Expander>

      <!-- Linux-Desktop -->
      <Border Classes="card">
        <StackPanel Spacing="12">
          <TextBlock Classes="section" Text="{l:T Linux_DesktopTitle}" />
          <ToggleSwitch IsChecked="{Binding Notifications}" Content="{l:T Linux_NotificationsToggle}"
                        OnContent="" OffContent="" AutomationProperties.Name="{l:T Linux_NotificationsToggle}" />
          <TextBlock Classes="muted small" Text="{l:T Linux_NotificationsHint}" />
          <WrapPanel Orientation="Horizontal">
            <Button Classes="secondary" Command="{Binding TestNotificationCommand}" Margin="0,0,12,0">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <PathIcon Data="{StaticResource IconBell}" Width="16" Height="16" />
                <TextBlock Text="{l:T Linux_TestNotification}" />
              </StackPanel>
            </Button>
            <TextBlock Classes="muted" Text="{Binding NotificationFeedback}" IsVisible="{Binding HasNotificationFeedback}" VerticalAlignment="Center" />
          </WrapPanel>
          <Rectangle Height="1" Fill="{DynamicResource RoGLineBrush}" Margin="0,4" />
          <ToggleSwitch IsChecked="{Binding CloseToTray}" Content="{l:T SettingsPage_CloseToTray.Header}"
                        OnContent="" OffContent="" AutomationProperties.Name="{l:T SettingsPage_CloseToTray.Header}" />
          <TextBlock Classes="muted small" Text="{l:T Linux_CloseToTrayHint}" IsVisible="{Binding !TrayUnavailable}" />
          <Border Classes="hint" IsVisible="{Binding TrayUnavailable}">
            <Grid ColumnDefinitions="Auto,*">
              <PathIcon Data="{StaticResource IconInfo}" Width="18" Height="18" Margin="0,0,10,0" VerticalAlignment="Top" Foreground="{DynamicResource RoGGoldBrush}" />
              <TextBlock Grid.Column="1" Classes="body" Text="{l:T Linux_TrayUnavailable}" />
            </Grid>
          </Border>
          <ToggleSwitch IsChecked="{Binding Autostart}" IsEnabled="{Binding CanChangeAutostart}" Content="{l:T Linux_Autostart}"
                        OnContent="" OffContent="" AutomationProperties.Name="{l:T Linux_Autostart}" />
          <TextBlock Classes="muted small" Text="{l:T Linux_AutostartHint}" />
          <TextBlock Classes="muted small" Text="{l:T Linux_AutostartPortalHint}" IsVisible="{Binding AutostartUsesPortal}" />
          <TextBlock Classes="body" Foreground="{DynamicResource RoGRedTextBrush}" Text="{Binding AutostartFeedback}" IsVisible="{Binding HasAutostartFeedback}" />
        </StackPanel>
      </Border>

      <!-- Controller (Steam Deck, Gamepads über SDL) -->
      <Border x:Name="ControllerCard" Classes="card" DataContext="{Binding Controller}" x:DataType="vm:ControllerSettingsViewModel">
        <StackPanel Spacing="12">
          <TextBlock Classes="section" Text="{l:T Linux_ControllerTitle}" />
          <ToggleSwitch IsChecked="{Binding Enabled}" IsEnabled="{Binding !IsUnavailable}"
                        OnContent="" OffContent="" AutomationProperties.Name="{l:T Linux_ControllerToggle}">
            <TextBlock Text="{l:T Linux_ControllerToggle}" TextWrapping="Wrap" />
          </ToggleSwitch>
          <TextBlock Classes="body strong" Text="{Binding StatusText}" TextWrapping="Wrap" IsVisible="{Binding !IsUnavailable}" />
          <Border Classes="hint" IsVisible="{Binding IsUnavailable}">
            <Grid ColumnDefinitions="Auto,*">
              <PathIcon Data="{StaticResource IconInfo}" Width="18" Height="18" Margin="0,0,10,0" VerticalAlignment="Top" Foreground="{DynamicResource RoGGoldBrush}" />
              <TextBlock Grid.Column="1" Classes="body" Text="{Binding StatusText}" TextWrapping="Wrap" />
            </Grid>
          </Border>
          <TextBlock Classes="muted small" Text="{l:T Linux_ControllerHint}" TextWrapping="Wrap" />
          <TextBlock Classes="muted small" Text="{l:T Linux_GameModeActive}" TextWrapping="Wrap" IsVisible="{Binding IsGameMode}" />
          <TextBlock Classes="label" Text="{l:T Linux_ControllerMappingTitle}" Margin="0,4,0,0" />
          <ItemsControl ItemsSource="{Binding Mapping}" AutomationProperties.Name="{l:T Linux_ControllerMappingTitle}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ShortcutRow">
                <Grid ColumnDefinitions="*,2*" Margin="0,3" AutomationProperties.Name="{Binding Description}">
                  <TextBlock Classes="body strong" Text="{Binding Keys}" TextWrapping="Wrap" Margin="0,0,12,0" />
                  <TextBlock Grid.Column="1" Classes="body" Text="{Binding Description}" TextWrapping="Wrap" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- App-Sperre (Windows: „App-Sperre mit Windows Hello“) – PIN im Schlüsselbund, optional Fingerabdruck -->
      <Border Classes="card" DataContext="{Binding AppLock}" x:DataType="vm:AppLockSettingsViewModel">
        <StackPanel Spacing="12">
          <TextBlock Classes="section" Text="{l:T Linux_AppLockTitle}" />
          <c:FeedbackBar DataContext="{Binding Feedback}" />
          <ToggleSwitch IsChecked="{Binding Enabled}" IsEnabled="{Binding CanUseAppLock}"
                        OnContent="" OffContent="" AutomationProperties.Name="{l:T Linux_AppLockToggle}">
            <TextBlock Text="{l:T Linux_AppLockToggle}" TextWrapping="Wrap" />
          </ToggleSwitch>
          <TextBlock Classes="muted small" Text="{l:T Linux_AppLockHint}" TextWrapping="Wrap" />
          <Border Classes="hint" IsVisible="{Binding ShowKeyringHint}">
            <Grid ColumnDefinitions="Auto,*">
              <PathIcon Data="{StaticResource IconKey}" Width="18" Height="18" Margin="0,0,10,0" VerticalAlignment="Top" Foreground="{DynamicResource RoGGoldBrush}" />
              <TextBlock Grid.Column="1" Classes="body" Text="{l:T Linux_AppLockNoKeyring}" TextWrapping="Wrap" />
            </Grid>
          </Border>

          <!-- PIN setzen bzw. ändern (im Inhalt, Escape bricht ab) -->
          <Border Classes="hint info" IsVisible="{Binding IsPinFormOpen}">
            <StackPanel Spacing="10">
              <StackPanel.KeyBindings>
                <KeyBinding Gesture="Escape" Command="{Binding CancelPinCommand}" />
                <KeyBinding Gesture="Enter" Command="{Binding SavePinCommand}" />
              </StackPanel.KeyBindings>
              <TextBlock Classes="body strong" Text="{l:T Linux_AppLockSetPinTitle}" IsVisible="{Binding !IsChangingPin}" />
              <TextBlock Classes="body strong" Text="{l:T Linux_AppLockChangePin}" IsVisible="{Binding IsChangingPin}" />
              <WrapPanel Orientation="Horizontal">
                <StackPanel Margin="0,0,12,8" IsVisible="{Binding IsChangingPin}">
                  <TextBlock Classes="label" Text="{l:T Linux_AppLockCurrentPin}" />
                  <TextBox Width="170" Text="{Binding CurrentPin}" PasswordChar="•" MaxLength="8" AutomationProperties.Name="{l:T Linux_AppLockCurrentPin}" />
                </StackPanel>
                <StackPanel Margin="0,0,12,8">
                  <TextBlock Classes="label" Text="{l:T Linux_AppLockNewPin}" />
                  <TextBox Width="170" Text="{Binding NewPin}" PasswordChar="•" MaxLength="8" AutomationProperties.Name="{l:T Linux_AppLockNewPin}" />
                </StackPanel>
                <StackPanel Margin="0,0,12,8">
                  <TextBlock Classes="label" Text="{l:T Linux_AppLockConfirmPin}" />
                  <TextBox Width="170" Text="{Binding ConfirmPin}" PasswordChar="•" MaxLength="8" AutomationProperties.Name="{l:T Linux_AppLockConfirmPin}" />
                </StackPanel>
              </WrapPanel>
              <TextBlock Classes="body" Foreground="{DynamicResource RoGRedTextBrush}" Text="{Binding FormError}" IsVisible="{Binding HasFormError}" TextWrapping="Wrap" />
              <WrapPanel Orientation="Horizontal">
                <Button Classes="primary" Margin="0,0,12,0" Command="{Binding SavePinCommand}" Content="{l:T Linux_AppLockSavePin, Upper=True}" />
                <Button Classes="secondary" Command="{Binding CancelPinCommand}" Content="{l:T Common_Cancel, Upper=True}" />
              </WrapPanel>
            </StackPanel>
          </Border>

          <StackPanel Spacing="12" IsVisible="{Binding ShowOptions}">
            <StackPanel>
              <TextBlock Classes="label" Text="{l:T Linux_AppLockMinutes}" />
              <ComboBox MinWidth="200" ItemsSource="{Binding MinutesOptions}" SelectedItem="{Binding SelectedMinutes}"
                        AutomationProperties.Name="{l:T Linux_AppLockMinutes}" />
            </StackPanel>
            <ToggleSwitch IsChecked="{Binding Fingerprint}" IsVisible="{Binding FingerprintAvailable}"
                          OnContent="" OffContent="" AutomationProperties.Name="{l:T Linux_AppLockFingerprintToggle}">
              <TextBlock Text="{l:T Linux_AppLockFingerprintToggle}" TextWrapping="Wrap" />
            </ToggleSwitch>
            <TextBlock Classes="muted small" Text="{l:T Linux_AppLockFingerprintHint}" IsVisible="{Binding FingerprintAvailable}" TextWrapping="Wrap" />
            <TextBlock Classes="muted small" Text="{l:T Linux_AppLockFingerprintNone}" IsVisible="{Binding !FingerprintAvailable}" TextWrapping="Wrap" />
            <Button Classes="secondary" HorizontalAlignment="Left" Command="{Binding ChangePinCommand}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <PathIcon Data="{StaticResource IconKey}" Width="16" Height="16" />
                <TextBlock Text="{l:T Linux_AppLockChangePin, Upper=True}" />
              </StackPanel>
            </Button>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Tastenkürzel (F1) -->
      <Border x:Name="ShortcutsCard" Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Classes="section" Text="{l:T Linux_ShortcutsTitle}" />
          <ItemsControl ItemsSource="{Binding Shortcuts}" AutomationProperties.Name="{l:T Linux_ShortcutsTitle}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ShortcutRow">
                <Grid ColumnDefinitions="200,*" Margin="0,3" AutomationProperties.Name="{Binding Description}">
                  <TextBlock Classes="body strong" FontFamily="{StaticResource RoGMonoFont}" FontSize="13" Text="{Binding Keys}" TextWrapping="Wrap" Margin="0,0,12,0" />
                  <TextBlock Grid.Column="1" Classes="body" Text="{Binding Description}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- Über die App -->
      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Classes="section" Text="{l:T SettingsPage_AboutTitle.Text}" />
          <TextBlock Classes="body strong" Text="{Binding AppVersionText}" />
          <TextBlock Classes="muted" Text="{Binding PlatformText}" />
          <TextBlock Classes="muted small" Text="{Binding EnvironmentText}" />
          <TextBlock Classes="muted small" Text="{Binding PackageText}" />
          <TextBlock Classes="muted small" Text="{Binding DisplayText}" />
          <TextBlock Classes="muted small" Text="{Binding RealtimeText}" />
          <WrapPanel Orientation="Horizontal" Margin="0,4,0,0">
            <Button Classes="link pad" Command="{Binding OpenWebsiteCommand}"><TextBlock Text="{l:T SettingsPage_Website.Content}" /></Button>
            <Button Classes="link pad" Command="{Binding OpenStatusCommand}"><TextBlock Text="{l:T SettingsPage_Status.Content}" /></Button>
            <Button Classes="link pad" Command="{Binding OpenPrivacyCommand}"><TextBlock Text="{l:T SettingsPage_Privacy.Content}" /></Button>
            <Button Classes="link pad" Command="{Binding OpenTermsCommand}"><TextBlock Text="{l:T SettingsPage_Terms.Content}" /></Button>
            <Button Classes="link pad" Command="{Binding OpenImprintCommand}"><TextBlock Text="{l:T SettingsPage_Imprint.Content}" /></Button>
            <Button Classes="link pad" Command="{Binding OpenChildSafetyCommand}"><TextBlock Text="{l:T SettingsPage_ChildSafety.Content}" /></Button>
          </WrapPanel>
          <!-- Copyright wie im Website-Footer: Clan, dahinter „Copyright by wahke“ mit Link -->
          <WrapPanel Orientation="Horizontal">
            <TextBlock Classes="muted small" Text="{Binding CopyrightText}" VerticalAlignment="Center" />
            <TextBlock Classes="muted small" Text=" · " VerticalAlignment="Center" />
            <TextBlock Classes="muted small" Text="{l:T SettingsPage_Credit.Text}" VerticalAlignment="Center" Margin="0,0,4,0" />
            <Button Classes="link" Command="{Binding OpenCreditCommand}" VerticalAlignment="Center">
              <TextBlock Classes="small" Text="{l:T SettingsPage_CreditName.Text}" />
            </Button>
          </WrapPanel>
        </StackPanel>
      </Border>

      <!-- Lizenzen -->
      <Border Classes="card">
        <StackPanel Spacing="8">
          <TextBlock Classes="section" Text="{l:T SettingsPage_LicensesTitle.Text}" />
          <TextBlock Classes="muted" Text="{l:T SettingsPage_LicensesText.Text}" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
