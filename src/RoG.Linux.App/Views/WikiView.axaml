<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RoG.Linux.App.ViewModels"
             xmlns:c="using:RoG.Linux.App.Controls"
             xmlns:l="using:RoG.Linux.App.Localization"
             x:Class="RoG.Linux.App.Views.WikiView"
             x:DataType="vm:WikiViewModel">
  <UserControl.Styles>
    <!-- Vergleich: neue Zeilen grün, entfernte rot (Theme-Farben), Zeichen +/- zusätzlich zur Farbe -->
    <Style Selector="Border.diffline">
      <Setter Property="Padding" Value="10,2" />
      <Setter Property="BorderThickness" Value="3,0,0,0" />
    </Style>
    <Style Selector="Border.diffline.added">
      <Setter Property="BorderBrush" Value="{DynamicResource RoGGreenBrush}" />
    </Style>
    <Style Selector="Border.diffline.removed">
      <Setter Property="BorderBrush" Value="{DynamicResource RoGRedBrush}" />
    </Style>
    <Style Selector="Border.diffline.added SelectableTextBlock">
      <Setter Property="Foreground" Value="{DynamicResource RoGGreenBrush}" />
    </Style>
    <Style Selector="Border.diffline.removed SelectableTextBlock">
      <Setter Property="Foreground" Value="{DynamicResource RoGRedBrush}" />
    </Style>
  </UserControl.Styles>

  <!-- Wiki wie WikiPage der Windows-App: links Bereich, Suche, Baum bzw. Kategorien; rechts die Seite -->
  <c:ListDetailPanel x:Name="Panel" IsDetailOpen="{Binding IsDetailOpen}">
    <!-- Liste -->
    <Border BorderBrush="{DynamicResource RoGLineBrush}" BorderThickness="0,0,1,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Spacing="10" Margin="24,24,16,12">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="display" Text="{l:T WikiPage_Title.Text}" />
            <Button Grid.Column="1" Classes="icon" VerticalAlignment="Center" Command="{Binding RefreshCommand}"
                    ToolTip.Tip="{l:T Linux_Refresh}" AutomationProperties.Name="{l:T Linux_Refresh}">
              <PathIcon Data="{StaticResource IconRefresh}" Width="20" Height="20" />
            </Button>
          </Grid>
          <StackPanel Spacing="4">
            <TextBlock Classes="label" Text="{l:T WikiPage_Namespace.Header}" />
            <ComboBox ItemsSource="{Binding Namespaces}" SelectedItem="{Binding SelectedNamespace}" HorizontalAlignment="Stretch"
                      AutomationProperties.Name="{l:T WikiPage_Namespace.Header}" />
          </StackPanel>
          <TextBox x:Name="SearchBox" Text="{Binding SearchText}" PlaceholderText="{l:T WikiPage_Search.PlaceholderText}"
                   AutomationProperties.Name="{l:T WikiPage_Search.PlaceholderText}">
            <TextBox.KeyBindings>
              <KeyBinding Gesture="Enter" Command="{Binding SearchCommand}" />
            </TextBox.KeyBindings>
            <TextBox.InnerRightContent>
              <StackPanel Orientation="Horizontal">
                <Button Classes="icon" Width="32" Height="32" Padding="8" Command="{Binding ClearSearchCommand}" IsVisible="{Binding HasSearchText}"
                        ToolTip.Tip="{l:T Linux_WikiSearchClear}" AutomationProperties.Name="{l:T Linux_WikiSearchClear}">
                  <PathIcon Data="{StaticResource IconClose}" Width="12" Height="12" />
                </Button>
                <Button Classes="icon" Width="32" Height="32" Padding="8" Command="{Binding SearchCommand}"
                        ToolTip.Tip="{l:T WikiPage_Search.PlaceholderText}" AutomationProperties.Name="{l:T WikiPage_Search.PlaceholderText}">
                  <PathIcon Data="{StaticResource IconSearch}" Width="14" Height="14" />
                </Button>
              </StackPanel>
            </TextBox.InnerRightContent>
          </TextBox>
          <WrapPanel Orientation="Horizontal">
            <ToggleButton Classes="segment" Margin="0,0,8,8" IsChecked="{Binding ShowCategories}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="{StaticResource IconList}" Width="14" Height="14" />
                <TextBlock Text="{l:T WikiPage_Categories.Content, Upper=True}" />
              </StackPanel>
            </ToggleButton>
            <Button Classes="primary" Margin="0,0,8,8" Command="{Binding StartCreateCommand}" IsVisible="{Binding CanCreate}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <PathIcon Data="{StaticResource IconPlus}" Width="14" Height="14" />
                <TextBlock Text="{l:T WikiPage_NewPage.Content}" />
              </StackPanel>
            </Button>
          </WrapPanel>
          <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding HasCategory}">
            <Button Classes="link" Command="{Binding LeaveCategoryCommand}" Content="{l:T WikiPage_BackToCategories.Content}" />
            <TextBlock Grid.Column="1" Classes="body strong" Margin="12,0,0,0" VerticalAlignment="Center" Text="{Binding CategoryTitle}"
                       TextTrimming="CharacterEllipsis" />
          </Grid>
          <Border Classes="hint info" Background="{DynamicResource RoGBg3Brush}" IsVisible="{Binding IsGuest}">
            <StackPanel Spacing="10">
              <TextBlock Classes="body" Text="{l:T Linux_WikiGuest}" TextWrapping="Wrap" />
              <Button Classes="primary" HorizontalAlignment="Left" Command="{Binding SignInCommand}" Content="{l:T Linux_SignIn}" />
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- Offline -->
        <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="16,8,16,16">
          <Button Classes="secondary" HorizontalAlignment="Stretch" Command="{Binding SaveNamespaceOfflineCommand}"
                  IsVisible="{Binding CanSaveOffline}" IsEnabled="{Binding IsNotSavingOffline}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <PathIcon Data="{StaticResource IconDownload}" Width="16" Height="16" />
              <TextBlock Text="{l:T Linux_WikiSaveOffline}" />
            </StackPanel>
          </Button>
          <TextBlock Classes="muted small" Text="{Binding OfflineProgress}" IsVisible="{Binding IsSavingOffline}" />
          <TextBlock Classes="muted small" Text="{l:T Linux_WikiOfflineInfo}" TextWrapping="Wrap" IsVisible="{Binding CanSaveOffline}" />
          <TextBlock Classes="muted small" Text="{l:T Linux_WikiOfflineUnavailable}" TextWrapping="Wrap" IsVisible="{Binding ShowOfflineUnavailable}" />
        </StackPanel>

        <Panel>
          <c:StateView IsLoading="{Binding IsLoading}" ErrorMessage="{Binding ErrorMessage}" IsEmpty="{Binding IsEmpty}"
                       EmptyText="{l:T WikiPage_State.EmptyText}" RetryCommand="{Binding RefreshCommand}" />
          <ListBox Classes="cards" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" SelectionMode="Single"
                   IsVisible="{Binding ShowContent}" AutomationProperties.Name="{l:T WikiPage_List.AutomationProperties.Name}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:WikiListItem">
                <Grid ColumnDefinitions="Auto,*" Margin="{Binding Indent}" AutomationProperties.Name="{Binding Title}">
                  <PathIcon Data="{StaticResource IconWiki}" Width="16" Height="16" Margin="0,2,10,0" VerticalAlignment="Top"
                            Foreground="{DynamicResource RoGMutedBrush}" IsVisible="{Binding IsPage}" />
                  <PathIcon Data="{StaticResource IconList}" Width="16" Height="16" Margin="0,2,10,0" VerticalAlignment="Top"
                            Foreground="{DynamicResource RoGGoldBrush}" IsVisible="{Binding IsCategory}" />
                  <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Classes="body strong" Text="{Binding Title}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                    <TextBlock Classes="muted small" Text="{Binding Subtitle}" IsVisible="{Binding HasSubtitle}" TextWrapping="Wrap"
                               MaxLines="2" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Panel>
      </DockPanel>
    </Border>

    <!-- Detail -->
    <Panel>
      <TextBlock Classes="muted" Text="{l:T WikiPage_SelectHint.Text}" HorizontalAlignment="Center" VerticalAlignment="Center"
                 IsVisible="{Binding ShowSelectHint}" Margin="32" />
      <DockPanel IsVisible="{Binding ShowPageState}">
        <Button DockPanel.Dock="Top" Classes="secondary" HorizontalAlignment="Left" Margin="24,16,0,0" Command="{Binding CloseDetailCommand}"
                IsVisible="{Binding #Panel.IsNarrow}" AutomationProperties.Name="{l:T Common_Back}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <PathIcon Data="{StaticResource IconBack}" Width="16" Height="16" />
            <TextBlock Text="{l:T Common_Back}" />
          </StackPanel>
        </Button>
        <c:StateView IsLoading="{Binding IsPageLoading}" ErrorMessage="{Binding PageError}" RetryCommand="{Binding RetryPageCommand}" />
      </DockPanel>

      <!-- Neue Seite -->
      <DockPanel IsVisible="{Binding IsCreating}">
        <Border DockPanel.Dock="Top" Background="{DynamicResource RoGBg2Brush}" BorderBrush="{DynamicResource RoGLineBrush}" BorderThickness="0,0,0,1" Padding="16,12">
          <Grid ColumnDefinitions="Auto,*">
            <Button Classes="icon" Command="{Binding CancelCreateCommand}" Margin="0,0,8,0"
                    ToolTip.Tip="{l:T Common_Back}" AutomationProperties.Name="{l:T Common_Back}">
              <PathIcon Data="{StaticResource IconBack}" Width="18" Height="18" />
            </Button>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock Classes="title" FontSize="24" Text="{l:T Wiki_NewPageTitle}" TextWrapping="Wrap" />
              <TextBlock Classes="muted small" Text="{Binding NewPageHint}" TextWrapping="Wrap" />
            </StackPanel>
          </Grid>
        </Border>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="24,16,24,32" Spacing="12" MaxWidth="{StaticResource RoGReadingWidth}" HorizontalAlignment="Left">
            <c:FeedbackBar DataContext="{Binding Feedback}" />
            <StackPanel Spacing="4">
              <TextBlock Classes="label" Text="{l:T Wiki_NewTitle}" />
              <TextBox x:Name="NewTitleBox" Text="{Binding NewTitle}" MaxLength="200" AutomationProperties.Name="{l:T Wiki_NewTitle}" />
            </StackPanel>
            <WrapPanel Orientation="Horizontal">
              <StackPanel Spacing="4" Margin="0,0,16,8">
                <TextBlock Classes="label" Text="{l:T Wiki_NewFormat}" />
                <ComboBox MinWidth="200" ItemsSource="{Binding Formats}" SelectedItem="{Binding NewFormat}" AutomationProperties.Name="{l:T Wiki_NewFormat}" />
              </StackPanel>
              <StackPanel Spacing="4" Margin="0,0,0,8">
                <TextBlock Classes="label" Text="{l:T Wiki_NewParent}" />
                <ComboBox MinWidth="260" MaxWidth="420" ItemsSource="{Binding ParentOptions}" SelectedItem="{Binding NewParent}"
                          AutomationProperties.Name="{l:T Wiki_NewParent}" />
              </StackPanel>
            </WrapPanel>
            <StackPanel Spacing="4">
              <TextBlock Classes="label" Text="{l:T Wiki_NewContent}" />
              <TextBox Text="{Binding NewContent}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="220" MaxHeight="480"
                       FontFamily="{StaticResource RoGMonoFont}" AutomationProperties.Name="{l:T Wiki_NewContent}" />
            </StackPanel>
            <StackPanel Spacing="4">
              <TextBlock Classes="label" Text="{l:T Wiki_NewSummary}" />
              <TextBox Text="{Binding NewSummary}" MaxLength="200" AutomationProperties.Name="{l:T Wiki_NewSummary}" />
            </StackPanel>
            <WrapPanel Orientation="Horizontal">
              <Button Classes="primary" Margin="0,0,8,8" Command="{Binding CreateCommand}" IsEnabled="{Binding IsNotBusy}"
                      Content="{l:T Wiki_NewCreate, Upper=True}" />
              <Button Classes="secondary" Margin="0,0,8,8" Command="{Binding CancelCreateCommand}" Content="{l:T Common_Cancel, Upper=True}" />
            </WrapPanel>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>

      <!-- Seite -->
      <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" IsVisible="{Binding ShowPage}">
        <StackPanel MaxWidth="{StaticResource RoGReadingWidth}" Margin="32,24,32,40" HorizontalAlignment="Left" Spacing="16">
          <Button Classes="secondary" HorizontalAlignment="Left" Command="{Binding CloseDetailCommand}"
                  IsVisible="{Binding #Panel.IsNarrow}" AutomationProperties.Name="{l:T Common_Back}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <PathIcon Data="{StaticResource IconBack}" Width="16" Height="16" />
              <TextBlock Text="{l:T Common_Back}" />
            </StackPanel>
          </Button>
          <StackPanel Spacing="4">
            <WrapPanel Orientation="Horizontal">
              <TextBlock Classes="kicker" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center" Text="{Binding NamespaceName}" />
              <Border Classes="chip green" IsVisible="{Binding IsSavedOffline}" VerticalAlignment="Center">
                <TextBlock Text="{l:T Linux_WikiAvailableOffline}" />
              </Border>
            </WrapPanel>
            <SelectableTextBlock Classes="title" Text="{Binding Title}" TextWrapping="Wrap" AutomationProperties.HeadingLevel="1" />
            <TextBlock Classes="muted" Text="{Binding PageMeta}" TextWrapping="Wrap" />
            <TextBlock Classes="body" Foreground="{DynamicResource RoGGoldBrush}" Text="{l:T WikiPage_OfflineCopy.Text}" TextWrapping="Wrap"
                       IsVisible="{Binding IsOfflineCopy}" />
          </StackPanel>
          <WrapPanel Orientation="Horizontal" IsVisible="{Binding ShowReader}">
            <Button Classes="primary" Margin="0,0,8,8" Command="{Binding EditCommand}" IsVisible="{Binding CanEdit}" IsEnabled="{Binding !IsOfflineCopy}"
                    Content="{l:T WikiPage_Edit.Content}" />
            <Button Classes="secondary" Margin="0,0,8,8" Command="{Binding ToggleWatchCommand}" IsVisible="{Binding CanWatch}" IsEnabled="{Binding !IsOfflineCopy}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <PathIcon Data="{StaticResource IconBell}" Width="16" Height="16" />
                <TextBlock Text="{Binding WatchLabel}" />
              </StackPanel>
            </Button>
            <Button Classes="secondary" Margin="0,0,8,8" Command="{Binding OpenInBrowserCommand}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <PathIcon Data="{StaticResource IconOpenExternal}" Width="16" Height="16" />
                <TextBlock Text="{l:T Common_OpenInBrowser.Content}" />
              </StackPanel>
            </Button>
          </WrapPanel>
          <c:FeedbackBar DataContext="{Binding Feedback}" />
          <c:ConfirmBar DataContext="{Binding Confirm}" />

          <!-- Bearbeitungskonflikt -->
          <Border Classes="hint error" Background="{DynamicResource RoGBg3Brush}" IsVisible="{Binding HasConflict}">
            <StackPanel Spacing="10">
              <TextBlock Classes="kicker" Text="{l:T Linux_WikiConflictTitle}" />
              <SelectableTextBlock Classes="body" Text="{Binding ConflictMessage}" TextWrapping="Wrap" />
              <WrapPanel Orientation="Horizontal">
                <Button Classes="primary" Margin="0,0,8,0" Command="{Binding SaveCommand}" IsEnabled="{Binding IsNotBusy}" Content="{l:T WikiPage_Save.Content}" />
                <Button Classes="secondary" Command="{Binding TakeTheirsCommand}" Content="{l:T Linux_WikiTakeTheirs}" />
              </WrapPanel>
            </StackPanel>
          </Border>

          <!-- Unterschiede (Vergleich oder Konflikt) -->
          <StackPanel x:Name="DiffPanel" Spacing="8" IsVisible="{Binding HasDiff}">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="2">
                <TextBlock Classes="section" Text="{l:T WikiPage_DiffTitle.Text}" />
                <TextBlock Classes="muted small" Text="{Binding DiffTitle}" TextWrapping="Wrap" />
              </StackPanel>
              <Button Grid.Column="1" Classes="icon" VerticalAlignment="Top" Command="{Binding CloseDiffCommand}"
                      ToolTip.Tip="{l:T Linux_WikiCloseDiff}" AutomationProperties.Name="{l:T Linux_WikiCloseDiff}">
                <PathIcon Data="{StaticResource IconClose}" Width="14" Height="14" />
              </Button>
            </Grid>
            <Border Background="{DynamicResource RoGBg2Brush}" BorderBrush="{DynamicResource RoGLineBrush}" BorderThickness="1"
                    CornerRadius="{StaticResource RoGControlRadius}" Padding="0,8">
              <StackPanel>
                <TextBlock Classes="muted" Margin="12,4" Text="{l:T Config_Unchanged}" IsVisible="{Binding IsDiffUnchanged}" />
                <ItemsControl ItemsSource="{Binding DiffLines}" AutomationProperties.Name="{l:T WikiPage_DiffTitle.Text}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:WikiDiffLine">
                      <Border Classes="diffline" Classes.added="{Binding IsAdded}" Classes.removed="{Binding IsRemoved}">
                        <SelectableTextBlock Text="{Binding Display}" FontFamily="{StaticResource RoGMonoFont}" FontSize="13" TextWrapping="Wrap" />
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </StackPanel>


          <!-- Inhaltsverzeichnis -->
          <Expander HorizontalAlignment="Stretch" IsVisible="{Binding ShowToc}" IsExpanded="True">
            <Expander.Header>
              <TextBlock Classes="body strong" Text="{l:T WikiPage_Toc.Header}" />
            </Expander.Header>
            <ItemsControl ItemsSource="{Binding Toc}" AutomationProperties.Name="{l:T WikiPage_Toc.Header}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:WikiTocItem">
                  <Button Classes="link" Margin="{Binding Indent}" Padding="0,3" HorizontalAlignment="Left"
                          Command="{Binding $parent[UserControl].((vm:WikiViewModel)DataContext).GoToHeadingCommand}" CommandParameter="{Binding}"
                          AutomationProperties.Name="{Binding Text}">
                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Expander>

          <!-- Lesen -->
          <c:RichContentView x:Name="Reader" Document="{Binding Document}" IsVisible="{Binding ShowReader}" />

          <!-- Bearbeiten -->
          <StackPanel Spacing="10" IsVisible="{Binding IsEditing}">
            <TextBox x:Name="Editor" Text="{Binding EditContent}" AcceptsReturn="True" AcceptsTab="False" TextWrapping="Wrap"
                     MinHeight="320" MaxHeight="640" FontFamily="{StaticResource RoGMonoFont}" FontSize="13"
                     AutomationProperties.Name="{l:T WikiPage_Editor.AutomationProperties.Name}" />
            <TextBox Text="{Binding EditSummary}" MaxLength="200" PlaceholderText="{l:T WikiPage_Summary.PlaceholderText}"
                     AutomationProperties.Name="{l:T WikiPage_Summary.PlaceholderText}" />
            <WrapPanel Orientation="Horizontal">
              <Button Classes="primary" Margin="0,0,8,8" Command="{Binding SaveCommand}" IsEnabled="{Binding IsNotBusy}" Content="{l:T WikiPage_Save.Content}" />
              <Button Classes="secondary" Margin="0,0,8,8" Command="{Binding PreviewCommand}" Content="{l:T WikiPage_Preview.Content}" />
              <Button Classes="secondary" Margin="0,0,8,8" Click="OnInsertImageClick" IsEnabled="{Binding IsNotBusy}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <PathIcon Data="{StaticResource IconMedia}" Width="16" Height="16" />
                  <TextBlock Text="{l:T WikiPage_InsertImage.Content}" />
                </StackPanel>
              </Button>
              <Button Classes="secondary" Margin="0,0,8,8" Command="{Binding CancelEditCommand}" Content="{l:T Common_CancelButton.Content, Upper=True}" />
              <ProgressBar IsIndeterminate="True" Width="80" Margin="0,0,0,8" VerticalAlignment="Center" IsVisible="{Binding IsUploadingImage}" />
            </WrapPanel>
            <StackPanel Spacing="8" IsVisible="{Binding HasPreview}">
              <TextBlock Classes="section" Text="{l:T WikiPage_PreviewTitle.Text}" />
              <Border Classes="card">
                <c:RichContentView Document="{Binding PreviewDocument}" />
              </Border>
            </StackPanel>
          </StackPanel>

          <!-- Versionen -->
          <Expander HorizontalAlignment="Stretch" IsExpanded="{Binding IsRevisionsExpanded}" IsVisible="{Binding !IsOfflineCopy}">
            <Expander.Header>
              <TextBlock Classes="body strong" Text="{l:T WikiPage_Revisions.Header}" />
            </Expander.Header>
            <StackPanel Spacing="8">
              <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsLoadingRevisions}" />
              <TextBlock Classes="muted" Text="{l:T Linux_WikiRevisionsEmpty}" IsVisible="{Binding HasNoRevisions}" />
              <ItemsControl ItemsSource="{Binding Revisions}" AutomationProperties.Name="{l:T WikiPage_Revisions.Header}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><StackPanel Spacing="10" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:WikiRevisionItemViewModel">
                    <StackPanel Spacing="4">
                      <WrapPanel Orientation="Horizontal">
                        <Border Classes="chip gold" Margin="0,0,8,0" VerticalAlignment="Center" IsVisible="{Binding HasStatus}">
                          <TextBlock Text="{Binding Status}" />
                        </Border>
                        <TextBlock Classes="body" Text="{Binding Text}" TextWrapping="Wrap" VerticalAlignment="Center" />
                      </WrapPanel>
                      <WrapPanel Orientation="Horizontal">
                        <Button Classes="link" Margin="0,0,16,0" Command="{Binding CompareCommand}" Content="{l:T WikiPage_Compare.Content}" />
                        <Button Classes="link" Margin="0,0,16,0" Command="{Binding RestoreCommand}" IsVisible="{Binding CanRestore}" Content="{l:T Config_Rollback.Content}" />
                        <Button Classes="link" Margin="0,0,16,0" Command="{Binding ApproveCommand}" IsVisible="{Binding CanDecide}" Content="{l:T Approval_ApproveLink.Content}" />
                        <Button Classes="link" Command="{Binding RejectCommand}" IsVisible="{Binding CanDecide}" Content="{l:T Approval_RejectLink.Content}" />
                      </WrapPanel>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Expander>
        </StackPanel>
      </ScrollViewer>
    </Panel>
  </c:ListDetailPanel>
</UserControl>
