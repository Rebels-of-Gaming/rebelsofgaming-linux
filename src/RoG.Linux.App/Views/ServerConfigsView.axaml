<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RoG.Linux.App.ViewModels"
             xmlns:c="using:RoG.Linux.App.Controls"
             xmlns:l="using:RoG.Linux.App.Localization"
             xmlns:core="using:RoG.Core.Features.Control"
             x:Class="RoG.Linux.App.Views.ServerConfigsView"
             x:DataType="vm:ServerConfigsViewModel">
  <!-- Reiter „Configs“ im Steuer-Fenster (wie ConfigsPanel der Windows-App): Editor mit Zeilennummern, Diff vor dem
       Speichern (hinzugefügt grün, entfernt rot), Versionen mit Zurückspielen, Formular-Vorlage. Ab 900 px Editor und
       Seitenspalte nebeneinander, schmaler untereinander (Code-Behind). -->
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://rebelsofgaming/Themes/ServerIcons.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>
  <UserControl.Styles>
    <Style Selector="TextBlock.code, SelectableTextBlock.code">
      <Setter Property="FontFamily" Value="{StaticResource RoGMonoFont}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="LineHeight" Value="19" />
    </Style>
    <Style Selector="TextBlock.add">
      <Setter Property="Foreground" Value="{DynamicResource RoGGreenBrush}" />
    </Style>
    <Style Selector="TextBlock.remove">
      <Setter Property="Foreground" Value="{DynamicResource RoGRedBrush}" />
    </Style>
    <Style Selector="TextBox.editor">
      <Setter Property="FontFamily" Value="{StaticResource RoGMonoFont}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="LineHeight" Value="19" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Padding" Value="10,10,16,10" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="TextBox.editor:focus /template/ Border#PART_BorderElement, TextBox.editor:pointerover /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
  </UserControl.Styles>

  <DockPanel Margin="16,12,16,16">
    <!-- Kopf: Datei wählen, Formular, Laden/Herunterladen, Hinweise -->
    <StackPanel DockPanel.Dock="Top" Spacing="10" Margin="0,0,0,12">
      <WrapPanel Orientation="Horizontal" IsVisible="{Binding HasFile}">
        <ComboBox x:Name="FileBox" MinWidth="260" MaxWidth="520" Margin="0,0,12,8" ItemsSource="{Binding Files}" SelectedItem="{Binding SelectedFile}"
                  AutomationProperties.Name="{l:T Config_File.Header}">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="core:ConfigFile">
              <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <Button Classes="secondary" Margin="0,0,12,8" Command="{Binding OpenTemplateCommand}" IsVisible="{Binding HasTemplate}"
                Content="{l:T Config_Template.Content}" />
        <Button Classes="secondary" Margin="0,0,12,8" Click="OnImportClick" IsVisible="{Binding CanWrite}"
                AutomationProperties.Name="{l:T Linux_ConfigImport}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <PathIcon Data="{StaticResource IconUpload}" Width="16" Height="16" />
            <TextBlock Text="{l:T Linux_ConfigImport, Upper=True}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Classes="icon" Margin="0,2,4,8" Command="{Binding DownloadCommand}"
                ToolTip.Tip="{l:T Backup_Download.Content}" AutomationProperties.Name="{l:T Backup_Download.Content}">
          <PathIcon Data="{StaticResource IconDownload}" Width="18" Height="18" />
        </Button>
        <Button Classes="icon" Margin="0,2,0,8" Command="{Binding ReloadFileCommand}"
                ToolTip.Tip="{l:T Linux_ConfigReloadFile}" AutomationProperties.Name="{l:T Linux_ConfigReloadFile}">
          <PathIcon Data="{StaticResource IconRefresh}" Width="18" Height="18" />
        </Button>
        <Border Classes="chip red" IsVisible="{Binding IsDirty}" VerticalAlignment="Center" Margin="8,0,0,8">
          <TextBlock Text="{l:T Linux_ConfigDirty}" />
        </Border>
      </WrapPanel>
      <Border Classes="hint" IsVisible="{Binding IsReadOnly}" HorizontalAlignment="Left">
        <TextBlock Classes="muted" Text="{l:T Linux_ConfigReadOnly}" />
      </Border>
      <Border Classes="hint" IsVisible="{Binding NeedsApproval}" HorizontalAlignment="Left">
        <TextBlock Classes="muted" Text="{l:T Linux_ConfigApprovalHint}" />
      </Border>
      <Panel MaxWidth="{StaticResource RoGReadingWidth}" HorizontalAlignment="Left">
        <Panel.IsVisible>
          <MultiBinding Converter="{x:Static BoolConverters.And}">
            <Binding Path="ShowOwnFeedback" />
            <Binding Path="Feedback.IsOpen" />
          </MultiBinding>
        </Panel.IsVisible>
        <c:FeedbackBar DataContext="{Binding Feedback}" />
      </Panel>
      <Button Classes="link" IsVisible="{Binding HasSavedPath}" Command="{Binding ShowInFolderCommand}" HorizontalAlignment="Left"
              Content="{l:T MediaPage_ShowInFolder.Content}" />
    </StackPanel>

    <!-- Speichern: Notiz, danach, Prüfen, Speichern (nur mit Schreibrecht) -->
    <StackPanel DockPanel.Dock="Bottom" Spacing="10" Margin="0,12,0,0">
      <StackPanel.IsVisible>
        <MultiBinding Converter="{x:Static BoolConverters.And}">
          <Binding Path="HasFile" />
          <Binding Path="!IsTemplateOpen" />
        </MultiBinding>
      </StackPanel.IsVisible>
      <c:ConfirmBar DataContext="{Binding Confirm}" MaxWidth="{StaticResource RoGReadingWidth}" HorizontalAlignment="Left" />
      <Grid x:Name="SaveBar" ColumnDefinitions="*,Auto,Auto,Auto" IsVisible="{Binding CanWrite}">
        <TextBox Text="{Binding Note}" MaxLength="190" PlaceholderText="{l:T Config_Note.PlaceholderText}" VerticalAlignment="Center"
                 AutomationProperties.Name="{l:T Config_Note.PlaceholderText}" />
        <ComboBox Grid.Column="1" Margin="12,0,0,0" MinWidth="200" VerticalAlignment="Center" ItemsSource="{Binding AfterOptions}"
                  SelectedItem="{Binding SelectedAfter}" AutomationProperties.Name="{l:T Config_After.AutomationProperties.Name}" />
        <Button Grid.Column="2" Classes="secondary" Margin="12,0,0,0" Command="{Binding PreviewCommand}" Content="{l:T Config_Preview.Content}" />
        <Button Grid.Column="3" Classes="primary" Margin="12,0,0,0" Command="{Binding SaveCommand}" Content="{l:T Config_Save.Content}" />
      </Grid>
    </StackPanel>

    <Panel>
      <c:StateView IsLoading="{Binding IsLoading}" ErrorMessage="{Binding ErrorMessage}" IsEmpty="{Binding IsEmpty}"
                   EmptyText="{l:T Config_Empty.Text}" RetryCommand="{Binding RefreshCommand}" />

      <!-- Formular-Vorlage (statt Dialog) -->
      <ScrollViewer IsVisible="{Binding IsTemplateOpen}" VerticalScrollBarVisibility="Auto">
        <Border Classes="card" DataContext="{Binding Template}" x:DataType="vm:ConfigTemplateFormViewModel"
                MaxWidth="{StaticResource RoGReadingWidth}" HorizontalAlignment="Left">
          <StackPanel Spacing="14">
            <TextBlock Classes="title" Text="{Binding Title}" />
            <TextBlock Classes="muted" Text="{Binding Description}" IsVisible="{Binding HasDescription}" />
            <ItemsControl ItemsSource="{Binding Fields}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Spacing="12" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:TemplateFieldViewModel">
                  <StackPanel>
                    <TextBlock Classes="label" Classes.error="{Binding HasError}" Text="{Binding Label}" IsVisible="{Binding ShowLabel}" />
                    <TextBox IsVisible="{Binding IsText}" Text="{Binding Text}" MaxLength="{Binding MaxLength}" AutomationProperties.Name="{Binding Label}" />
                    <TextBox IsVisible="{Binding IsList}" Text="{Binding Text}" AcceptsReturn="True" MinHeight="120" TextWrapping="NoWrap"
                             FontFamily="{StaticResource RoGMonoFont}" PlaceholderText="{Binding Placeholder}" AutomationProperties.Name="{Binding Label}" />
                    <StackPanel IsVisible="{Binding IsPassword}" Spacing="6">
                      <TextBox PasswordChar="●" Text="{Binding Text}" MaxLength="{Binding MaxLength}" PlaceholderText="{Binding Placeholder}"
                               AutomationProperties.Name="{Binding Label}" />
                      <CheckBox IsVisible="{Binding CanClearPassword}" IsChecked="{Binding ClearPassword}" Content="{l:T Template_PasswordClear}" />
                    </StackPanel>
                    <ComboBox IsVisible="{Binding IsSelect}" ItemsSource="{Binding Options}" SelectedItem="{Binding SelectedOption}" MinWidth="220"
                              AutomationProperties.Name="{Binding Label}" />
                    <CheckBox IsVisible="{Binding IsBool}" IsChecked="{Binding Checked}" Content="{Binding Label}" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel>
              <TextBlock Classes="label" Text="{l:T Template_Note}" />
              <TextBox Text="{Binding Note}" MaxLength="190" AutomationProperties.Name="{l:T Template_Note}" />
            </StackPanel>
            <Border Classes="error" IsVisible="{Binding HasError}">
              <TextBlock Classes="body" Text="{Binding Error}" />
            </Border>
            <WrapPanel Orientation="Horizontal">
              <Button Classes="primary" Margin="0,0,12,0" Command="{Binding ApplyCommand}" IsEnabled="{Binding !IsBusy}"
                      Content="{l:T Template_Apply}" />
              <Button Classes="secondary" Command="{Binding CancelCommand}" Content="{l:T Common_Cancel}" />
            </WrapPanel>
          </StackPanel>
        </Border>
      </ScrollViewer>

      <Grid x:Name="Body" ColumnDefinitions="*,360" RowDefinitions="*,Auto">
        <Grid.IsVisible>
          <MultiBinding Converter="{x:Static BoolConverters.And}">
            <Binding Path="ShowContent" />
            <Binding Path="!IsTemplateOpen" />
          </MultiBinding>
        </Grid.IsVisible>
        <!-- Editor mit Zeilennummern -->
        <Border x:Name="EditorCard" Classes="card" Padding="0" ClipToBounds="True">
          <Panel>
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
              <Grid ColumnDefinitions="Auto,*">
                <Border Background="{DynamicResource RoGBg3Brush}" BorderBrush="{DynamicResource RoGLineBrush}" BorderThickness="0,0,1,0">
                  <TextBlock Classes="code" Text="{Binding LineNumbers}" Foreground="{DynamicResource RoGMutedBrush}" TextAlignment="Right"
                             Margin="12,11,10,10" MinWidth="24" AutomationProperties.Name="{l:T Linux_ConfigLineNumbers}" />
                </Border>
                <TextBox x:Name="Editor" Grid.Column="1" Classes="editor" Text="{Binding Content}" AcceptsReturn="True" AcceptsTab="True"
                         TextWrapping="NoWrap" IsReadOnly="{Binding IsReadOnly}" MinHeight="200"
                         AutomationProperties.Name="{l:T Config_Editor.AutomationProperties.Name}" />
              </Grid>
            </ScrollViewer>
            <ProgressBar IsIndeterminate="True" VerticalAlignment="Top" IsVisible="{Binding IsFileLoading}" />
          </Panel>
        </Border>

        <!-- Seitenspalte: Prüfung (Diff, Fehler) und Versionen -->
        <ScrollViewer x:Name="Side" Grid.Column="1" Margin="16,0,0,0" VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="14" Margin="0,0,14,0">
            <StackPanel Spacing="8" IsVisible="{Binding HasDiff}">
              <TextBlock Classes="section" Text="{l:T Config_DiffTitle.Text}" />
              <Border Classes="error" IsVisible="{Binding HasErrors}">
                <ItemsControl ItemsSource="{Binding Errors}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                      <SelectableTextBlock Classes="body" Text="{Binding}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Border>
              <TextBlock Classes="muted" Text="{l:T Config_Unchanged}" IsVisible="{Binding IsUnchanged}" />
              <Border Classes="card" Padding="0,6" IsVisible="{Binding !IsUnchanged}">
                <ItemsControl ItemsSource="{Binding DiffLines}" AutomationProperties.Name="{l:T Linux_ConfigDiffLabel}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:DiffLineViewModel">
                      <Panel AutomationProperties.Name="{Binding Display}">
                        <Border Background="{DynamicResource RoGGreenBrush}" Opacity="0.14" IsVisible="{Binding IsAdded}" />
                        <Border Background="{DynamicResource RoGRedBrush}" Opacity="0.14" IsVisible="{Binding IsRemoved}" />
                        <Grid ColumnDefinitions="30,30,16,*" Margin="6,0,10,0">
                          <TextBlock Classes="code" Text="{Binding OldNumber}" Foreground="{DynamicResource RoGMutedBrush}" TextAlignment="Right" Margin="0,0,6,0" />
                          <TextBlock Grid.Column="1" Classes="code" Text="{Binding NewNumber}" Foreground="{DynamicResource RoGMutedBrush}" TextAlignment="Right" Margin="0,0,6,0" />
                          <TextBlock Grid.Column="2" Classes="code" Classes.add="{Binding IsAdded}" Classes.remove="{Binding IsRemoved}" Text="{Binding Marker}" FontWeight="Bold" />
                          <TextBlock Grid.Column="3" Classes="code" Classes.add="{Binding IsAdded}" Classes.remove="{Binding IsRemoved}"
                                     Foreground="{DynamicResource RoGInkBrush}" Text="{Binding Text}" TextWrapping="Wrap" />
                        </Grid>
                      </Panel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Border>
            </StackPanel>

            <TextBlock Classes="section" Text="{l:T Config_VersionsTitle.Text}" />
            <TextBlock Classes="muted" Text="{l:T Linux_ConfigVersionsEmpty}" IsVisible="{Binding ShowVersionsEmpty}" />
            <ItemsControl ItemsSource="{Binding Versions}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Spacing="6" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ConfigVersionItemViewModel">
                  <Grid ColumnDefinitions="Auto,*,Auto">
                    <PathIcon Data="{StaticResource IconClock}" Width="16" Height="16" Foreground="{DynamicResource RoGMutedBrush}" VerticalAlignment="Top" Margin="0,3,10,0" />
                    <TextBlock Grid.Column="1" Classes="body" FontSize="14" Text="{Binding Text}" />
                    <Button Grid.Column="2" Classes="link pad" Margin="12,0,0,0" VerticalAlignment="Top" Command="{Binding RollbackCommand}" IsVisible="{Binding CanWrite}"
                            Content="{l:T Config_Rollback.Content}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Panel>
  </DockPanel>
</UserControl>
