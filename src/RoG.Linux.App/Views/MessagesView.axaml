<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RoG.Linux.App.ViewModels"
             xmlns:c="using:RoG.Linux.App.Controls"
             xmlns:l="using:RoG.Linux.App.Localization"
             xmlns:v="using:RoG.Linux.App.Views"
             x:Class="RoG.Linux.App.Views.MessagesView"
             x:DataType="vm:MessagesViewModel">

  <c:ListDetailPanel x:Name="Panel" IsDetailOpen="{Binding IsDetailOpen}">
    <!-- Unterhaltungen -->
    <Border BorderBrush="{DynamicResource RoGLineBrush}" BorderThickness="0,0,1,0">
    <DockPanel>
      <StackPanel DockPanel.Dock="Top" Spacing="12" Margin="24,24,16,12">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Classes="display" Text="{l:T MessagesPage_Title.Text}" />
          <Button Grid.Column="1" Classes="icon" VerticalAlignment="Center" Command="{Binding RefreshCommand}"
                  ToolTip.Tip="{l:T Linux_Refresh}" AutomationProperties.Name="{l:T Linux_Refresh}">
            <PathIcon Data="{StaticResource IconRefresh}" Width="20" Height="20" />
          </Button>
        </Grid>
        <TextBox x:Name="SearchBox" Text="{Binding SearchText}" PlaceholderText="{l:T MessagesPage_Search.PlaceholderText}"
                 IsVisible="{Binding ShowConversations}" Margin="0,0,8,0"
                 AutomationProperties.Name="{l:T MessagesPage_Search.AutomationProperties.Name}" />
      </StackPanel>

      <Panel>
        <!-- Gastmodus -->
        <StackPanel Spacing="16" Margin="24" IsVisible="{Binding IsGuest}" VerticalAlignment="Center" HorizontalAlignment="Center">
          <TextBlock Classes="muted" Text="{l:T MessagesPage_Guest.Text}" TextAlignment="Center" />
          <Button Classes="primary" HorizontalAlignment="Center" Command="{Binding SignInCommand}" Content="{l:T Linux_SignIn}" />
        </StackPanel>

        <c:StateView IsLoading="{Binding IsLoading}" ErrorMessage="{Binding ErrorMessage}" IsEmpty="{Binding IsEmpty}"
                     EmptyText="{l:T MessagesPage_State.EmptyText}" RetryCommand="{Binding RefreshCommand}"
                     IsVisible="{Binding ShowConversations}" />
        <ListBox Classes="cards" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" SelectionMode="Single"
                 IsVisible="{Binding ShowContent}"
                 AutomationProperties.Name="{l:T MessagesPage_List.AutomationProperties.Name}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:ConversationItemViewModel">
              <Grid ColumnDefinitions="44,*,Auto" AutomationProperties.Name="{Binding Name}">
                <Panel Width="44" Height="44" VerticalAlignment="Top">
                  <Border CornerRadius="22" Background="{DynamicResource RoGBg3Brush}" BorderBrush="{DynamicResource RoGLineBrush}" BorderThickness="1">
                    <TextBlock Text="{Binding Initial}" FontFamily="{StaticResource RoGDisplayFont}" FontWeight="Bold" FontSize="20"
                               Foreground="{DynamicResource RoGMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <Border CornerRadius="22" ClipToBounds="True" IsVisible="{Binding !HasNoAvatar}">
                    <Image Source="{Binding Avatar}" Stretch="UniformToFill" />
                  </Border>
                  <Border IsVisible="{Binding IsGroup}" Width="20" Height="20" CornerRadius="10" Background="{DynamicResource RoGBg2Brush}"
                          HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-4,-4">
                    <PathIcon Data="{StaticResource IconGroup}" Width="12" Height="12" Foreground="{DynamicResource RoGMutedBrush}" />
                  </Border>
                </Panel>
                <StackPanel Grid.Column="1" Spacing="2" Margin="12,0,8,0">
                  <TextBlock Classes="body" Classes.strong="{Binding Unread}" Text="{Binding Name}" MaxLines="1" TextTrimming="CharacterEllipsis" />
                  <TextBlock Classes="muted small" Text="{Binding Preview}" MaxLines="2" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="6" HorizontalAlignment="Right">
                  <TextBlock Classes="muted small" Text="{Binding Time}" HorizontalAlignment="Right" />
                  <Ellipse Width="10" Height="10" Fill="{DynamicResource RoGRedBrush}" HorizontalAlignment="Right" IsVisible="{Binding Unread}" />
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Panel>
    </DockPanel>
    </Border>

    <!-- Verlauf -->
    <Panel>
      <TextBlock Classes="muted" Text="{l:T MessagesPage_SelectHint.Text}" HorizontalAlignment="Center" VerticalAlignment="Center"
                 IsVisible="{Binding ShowSelectHint}" Margin="32" />
      <DockPanel IsVisible="{Binding IsDetailOpen}">
        <Border DockPanel.Dock="Top" Background="{DynamicResource RoGBg2Brush}" BorderBrush="{DynamicResource RoGLineBrush}" BorderThickness="0,0,0,1"
                Padding="16,12">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <Button Classes="icon" Command="{Binding CloseDetailCommand}" IsVisible="{Binding #Panel.IsNarrow}"
                    ToolTip.Tip="{l:T Common_Back}" AutomationProperties.Name="{l:T Common_Back}" Margin="0,0,8,0">
              <PathIcon Data="{StaticResource IconBack}" Width="18" Height="18" />
            </Button>
            <TextBlock Grid.Column="1" Classes="title" FontSize="24" Text="{Binding Chat.Title}" VerticalAlignment="Center"
                       MaxLines="1" TextTrimming="CharacterEllipsis" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
              <Button Classes="icon" Command="{Binding PopOutCommand}"
                      ToolTip.Tip="{l:T MessagesPage_PopOut.ToolTipService.ToolTip}" AutomationProperties.Name="{l:T MessagesPage_PopOut.AutomationProperties.Name}">
                <PathIcon Data="{StaticResource IconPopOut}" Width="18" Height="18" />
              </Button>
              <Button Classes="icon" Command="{Binding OpenInBrowserCommand}"
                      ToolTip.Tip="{l:T Common_OpenInBrowser.Content}" AutomationProperties.Name="{l:T Common_OpenInBrowser.Content}">
                <PathIcon Data="{StaticResource IconOpenExternal}" Width="18" Height="18" />
              </Button>
            </StackPanel>
          </Grid>
        </Border>
        <v:ChatView DataContext="{Binding Chat}" />
      </DockPanel>
    </Panel>
  </c:ListDetailPanel>
</UserControl>
