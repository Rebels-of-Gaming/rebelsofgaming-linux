<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RoG.Linux.App.ViewModels"
             xmlns:l="using:RoG.Linux.App.Localization"
             x:Class="RoG.Linux.App.Views.PlaceholderView"
             x:DataType="vm:PlaceholderViewModel">
  <!-- Bereich kommt in einer späteren Stufe: gestalteter Leerzustand + Website-Link -->
  <Grid RowDefinitions="Auto,*" Margin="{StaticResource RoGPagePadding}">
    <TextBlock Classes="display" Text="{Binding Title}" />
    <StackPanel Grid.Row="1" Spacing="16" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440">
      <PathIcon Data="{Binding Icon}" Width="56" Height="56" Foreground="{StaticResource RoGLineBrush}" HorizontalAlignment="Center" />
      <TextBlock Classes="body" Text="{Binding Text}" TextAlignment="Center" />
      <TextBlock Classes="muted" Text="{Binding WebHint}" TextAlignment="Center" />
      <Button Classes="secondary" HorizontalAlignment="Center" Command="{Binding OpenInBrowserCommand}">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <PathIcon Data="{StaticResource IconOpenExternal}" Width="16" Height="16" />
          <TextBlock Text="{l:T Common_OpenInBrowser.Content}" />
        </StackPanel>
      </Button>
    </StackPanel>
  </Grid>
</UserControl>
