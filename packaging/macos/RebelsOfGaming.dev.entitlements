<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Ad-hoc-Signatur für CI-Rauchtest und lokale Tests ohne Zertifikat: dieselbe Sandbox wie im Store, aber ohne die an das
  Provisioning-Profil gebundenen Rechte (Team-/App-ID, Schlüsselbund-Gruppe) – die würden ohne Profil den Start
  verhindern. Der Schlüsselbund fällt dann auf den Anmelde-Schlüsselbund zurück (KeychainSecretBackend).
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.app-sandbox</key>
  <true/>
  <key>com.apple.security.network.client</key>
  <true/>
  <key>com.apple.security.network.server</key>
  <true/>
  <key>com.apple.security.files.user-selected.read-write</key>
  <true/>
  <key>com.apple.security.files.downloads.read-write</key>
  <true/>
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
</dict>
</plist>
