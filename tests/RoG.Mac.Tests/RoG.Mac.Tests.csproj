<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Tests der macOS-Verdrahtung (RoG.Mac.Platform) ohne Oberfläche und ohne D-Bus – laufen unter Linux (reine Logik)
    und im macOS-Workflow (zusätzlich echter Schlüsselbund, Mitteilungen außerhalb eines Bundles, NSWorkspace).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
    <NoWarn>$(NoWarn);CA1707;CA2000;CA1861;CA1515;CA1849;xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/RoG.Mac.Platform/RoG.Mac.Platform.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
